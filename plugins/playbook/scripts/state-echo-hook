#!/bin/bash
# state-echo-hook
# PostToolUse hook — shows the current gate from task.md, when it changed.
#
# Reads the active task's task.md, finds the first unchecked gate (- [ ]), and echoes it with file:line — in full
# when the gate, the task or a warning changed (and after a session start), one line every 10 calls on the same
# gate, nothing otherwise (task 219, below). Counts every call for the stop hook.

set -e

# Skip when invoked from the monitor's own claude session (see launch-monitor).
# Log to stderr so the hook's firing is still visible; only gate-enforcement skipped.
if [ "${PLAYBOOK_ROLE:-}" = "monitor" ]; then
    echo "[$(basename "$0")] skip (PLAYBOOK_ROLE=monitor)" >&2
    exit 0
fi

# Tool-type-aware micro-reflection nudges — 5 classes, each naming a specific failure mode.
# Call 1 on a new gate = silent. Call 2+ = class-specific nudge. Operate = always silent.
NUDGES_ORIENT=(
    "What am I looking for?"
    "Do I already know enough to act?"
    "Does this connect to the gate?"
    "Am I browsing or searching?"
    "What will I do with this information?"
)
NUDGES_EXECUTE=(
    "Is this the simplest change that works?"
    "How will I verify this?"
    "Does this serve the Intent or my own idea?"
    "Did I just introduce a problem?"
    "Would the user recognize this as what they asked for?"
)
NUDGES_TEST=(
    "Did I read the output or skim it?"
    "Did it pass for the right reason?"
    "What would a failure here look like?"
    "Am I testing what the Intent says, or what's easy to test?"
    "Is this gate done?"
)
NUDGES_REFLECT=(
    "If that was a bare checkmark, go back and append what happened."
    "Re-read what you just wrote — does it match what you did?"
    "Closing to move on? Or because it's actually done?"
    "Would a new agent understand this gate from what you wrote?"
    "If the next gate feels wrong, replan now — not after starting it."
)

# classify_tool TOOL_NAME INPUT_JSON
# Returns: orient, execute, test, operate, or reflect
classify_tool() {
    local tool="$1" input="$2"
    case "$tool" in
        Edit|Write|NotebookEdit)
            # Reflect: editing task.md in .agent/tasks/
            local fpath
            if [ -n "$PB_FUSED" ]; then fpath="$PB_PATH"; else
            fpath=$(echo "$input" | python3 -I -c "import sys,json; print(json.loads(sys.stdin.read()).get('tool_input',{}).get('file_path',''))" 2>/dev/null || echo "")
            fi
            if echo "$fpath" | grep -qE '\.agent(/[^/]+)?/tasks/.*/task\.md'; then
                echo "reflect"
            else
                echo "execute"
            fi
            ;;
        Bash)
            local cmd
            if [ -n "$PB_FUSED" ]; then cmd="$PB_CMD"; else
            cmd=$(echo "$input" | python3 -I -c "import sys,json; print(json.loads(sys.stdin.read()).get('tool_input',{}).get('command',''))" 2>/dev/null || echo "")
            fi
            if echo "$cmd" | grep -qE 'pytest|python.*-m\s+pytest|test_|grep\s+-c|assert'; then
                echo "test"
            else
                echo "operate"
            fi
            ;;
        Read|Grep|Glob|WebSearch|WebFetch|ToolSearch)
            echo "orient"
            ;;
        *)
            echo "operate"
            ;;
    esac
}

# Source shared lib (same directory)
HOOK_DIR="$(cd "$(dirname "$0")" && pwd)"
source "$HOOK_DIR/gate-echo-lib.sh"

# Find project root — only matches .agent/tasks/ (playbook projects)
PROJECT_DIR=$(find_project_root)
if [ -z "$PROJECT_DIR" ]; then
    echo '{}'
    exit 0
fi

# The Python floor (task 194, PLAN S14 T5, #46), advisory: below 3.10 the echo says so,
# reads no payload, writes and counts nothing — and MARKS the count it did not make
# (`counts_unsure`, below), so the stop hook holds the turn instead of releasing it on
# counts that stopped moving. The launchers' one-line probe. Asked only inside a project
# (impl panel r1, opus: before the project check every tool call of every project
# started python3).
PB_PY_FLOOR=true
if ! python3 -I -c 'import sys; sys.exit(0 if sys.version_info >= (3,10) else 1)' 2>/dev/null; then
    PB_PY_FLOOR=false
    PB_PY_FOUND="$(python3 --version 2>/dev/null | head -1 | tr -cd 'A-Za-z0-9._ -')"
    echo "playbook: needs python3 >= 3.10 (found: ${PB_PY_FOUND:-no python3 on PATH}) — no gate echo, this call not counted; upgrade python3" >&2
fi

AGENT_DIR=$(resolve_agent_dir "$PROJECT_DIR")

# Check writability for gate echo counter and transition logging
AGENT_WRITABLE=true
if ! agent_dir_writable "$PROJECT_DIR"; then
    AGENT_WRITABLE=false
fi

# Read stdin (PostToolUse JSON)
INPUT=$(cat)
# A call that FAILED reaches this hook as PostToolUseFailure (task 196, measured on Claude Code 2.1.296: a command
# that exits non-zero fires only that event). It is COUNTED like any other call — the stop hook's turn rules read the
# counts, and before, a turn whose only call was `sed -i … && false` (the file changed) read as a chat reply and
# ended with its gates open — and gets no gate echo and no write-log entry. Read from the payload's own key (only a
# top-level key can match unescaped; grok's camelCase too); an unmatched payload is a PostToolUse, as before.
PB_HOOK_EVENT=PostToolUse
PB_FAILURE_RE='"(hook_event_name|hookEventName)"[[:space:]]*:[[:space:]]*"PostToolUseFailure"'
[[ "$INPUT" =~ $PB_FAILURE_RE ]] && PB_HOOK_EVENT=PostToolUseFailure

# Normalize provider payload dialects (grok camelCase + renamed tools →
# claude snake_case; identity for claude payloads; fail-open on any error).
# One shot — every parse site below reads the normalized $INPUT (task 014).
# One process for the normalize AND every field this hook reads (tool_name, the
# edited path, the command, the transcript path) — see hook-payload-normalize.py
# `--emit-fields`. Each used to be its own `python3 -c`: four interpreter starts
# per tool call, on a hook bound to `.*`. NUL-delimited because commands contain
# newlines; the sentinel distinguishes "fused read ran" from "the script died",
# in which case the original per-field extraction below still applies.
PB_FUSED=""
PB_SENTINEL=""
PB_PAYLOAD=""
TOOL_NAME=""
PB_PATH=""
PB_NORM=""
PB_CMD=""
PB_TRANSCRIPT=""
PB_FRAME_COMPLETE=true
if [ "$PB_PY_FLOOR" = true ]; then
{
    IFS= read -r -d '' PB_SENTINEL   || PB_FRAME_COMPLETE=false
    IFS= read -r -d '' TOOL_NAME     || PB_FRAME_COMPLETE=false
    IFS= read -r -d '' PB_PATH       || PB_FRAME_COMPLETE=false
    IFS= read -r -d '' PB_NORM       || PB_FRAME_COMPLETE=false
    IFS= read -r -d '' PB_CMD        || PB_FRAME_COMPLETE=false
    IFS= read -r -d '' PB_TRANSCRIPT || PB_FRAME_COMPLETE=false
    IFS= read -r -d '' PB_PAYLOAD    || PB_FRAME_COMPLETE=false
} < <(printf '%s' "$INPUT" | python3 -E -s "$HOOK_DIR/hook-payload-normalize.py" --emit-fields 2>/dev/null) || true

if [ "$PB_SENTINEL" = "pb-fields-v3" ] && [ "$PB_FRAME_COMPLETE" = true ]; then     # its 8th record (the resolved path) is the gate's
    PB_FUSED=1
    INPUT="$PB_PAYLOAD"
else
    TOOL_NAME=""; PB_PATH=""; PB_NORM=""; PB_CMD=""; PB_TRANSCRIPT=""
    NORMALIZED=$(printf '%s' "$INPUT" | python3 -E -s "$HOOK_DIR/hook-payload-normalize.py" 2>/dev/null || true)
    if [ -n "$NORMALIZED" ]; then
        INPUT="$NORMALIZED"
    fi
    TOOL_NAME=$(echo "$INPUT" | python3 -I -c "import sys,json; print(json.loads(sys.stdin.read()).get('tool_name',''))" 2>/dev/null || echo "")
    # the shell log's command (task 221), cut at a NUL as the fused read cuts it
    case "$TOOL_NAME" in
        Bash|Monitor)
            PB_CMD=$(printf '%s' "$INPUT" | python3 -I -c \
                "import sys,json; ti=json.load(sys.stdin).get('tool_input',{}); v=ti.get('command','') if isinstance(ti,dict) else ''; sys.stdout.write(v.split(chr(0),1)[0] if isinstance(v,str) else '')" \
                2>/dev/null) || PB_CMD=""
            ;;
    esac
fi
fi    # (below the floor no payload is read)
export PB_FUSED PB_PATH PB_CMD

# The shell log (PHASE-B item 2, task 221; the owner 2026-10-16: "Doar comenzile mele", "Hook-ul scrie"): the agent's
# command — a Bash or Monitor call, as normalised (grok's Shell / run_terminal_command are Bash by now) — is one line
# of this lane's `bash_history`. From an EXIT trap, so it is written on every way out of this hook (a failed call, a
# subagent's, an unresolved session, a linked session directory) and AFTER the count and the echo: a slow lock can cost
# the line, never the count the stop hook reads (plan panel 2026-10-16). Only where this hook may write. The trap
# keeps the hook's exit status (`|| true`; `shell_log_append` always returns 0). The prefix the task gate puts in
# front of a `tasks` call (`export PLAYBOOK_SESSION_ID=<this session>; `, task 118 — the host runs and reports the
# command with it) is the plugin's, not the agent's: it is left out, and only when it names THIS session (measured
# live, task 221 W5: `export PLAYBOOK_SESSION_ID=pid-3703202; .claude/bin/tasks work 1 && echo activated`).
_pb_shell_log_on_exit() {
    local cmd="$PB_CMD"
    if [ "$AGENT_WRITABLE" = true ] && [ -n "$cmd" ]; then
        if [ -n "${SESSION_ID:-}" ]; then
            cmd="${cmd#"export PLAYBOOK_SESSION_ID=$SESSION_ID; "}"
        fi
        case "$TOOL_NAME" in
            Bash|Monitor) shell_log_append "$AGENT_DIR" "$cmd" ;;
        esac
    fi
    return 0
}
trap '_pb_shell_log_on_exit || true' EXIT

# Task 192 (#48): the id and what the resolver's own walk read, from ONE call (a
# second walk would not show a transient failure of the first).
PB_WALK_READ="$(resolve_session_id trace)"
SESSION_ID="${PB_WALK_READ%%$'\t'*}"
PB_WALK_READ="${PB_WALK_READ#*$'\t'}"
# Journaled on an unresolved id (and on every call under PLAYBOOK_WALK_TRACE=1) —
# never where this hook may not write.
if [ "$AGENT_WRITABLE" = true ]; then
    journal_session_walk "$AGENT_DIR" state-echo "$SESSION_ID" "$TOOL_NAME" "$PB_WALK_READ"
fi
# Task 105: unresolved (under the Claude Code background daemon, no
# PLAYBOOK_SESSION_ID) — no session to echo or count; writing would compose
# `sessions/` + "" (the sessions dir itself). One line, nothing else written.
if [ -z "$SESSION_ID" ]; then
    session_unresolved_notice
    exit 0
fi

# Below the floor: nothing written, nothing counted — the count not made is marked (the
# mark refuses a link and a linked directory, as everywhere). Said to the agent.
if [ "$PB_PY_FLOOR" != true ]; then
    if [ "$AGENT_WRITABLE" = true ] && [ -d "$AGENT_DIR/sessions/$SESSION_ID" ]; then
        _counters_mark "$AGENT_DIR/sessions/$SESSION_ID/counters"
    fi
    echo "{\"hookSpecificOutput\":{\"hookEventName\":\"${PB_HOOK_EVENT}\",\"additionalContext\":\"# ⚠ playbook needs python3 >= 3.10 (found: ${PB_PY_FOUND:-no python3 on PATH}) — no gate echo, and this call was not counted: the stop hook holds this turn like one that wrote. Upgrade python3.\"}}"
    exit 0
fi

# --- Eval mode: read config flags if PLAYBOOK_EVAL_CONFIG is set ---
EVAL_GATE_ECHO="on"
EVAL_NUDGES="typed"
if [ -n "$PLAYBOOK_EVAL_CONFIG" ] && [ -f "$PLAYBOOK_EVAL_CONFIG" ]; then
    EVAL_GATE_ECHO=$(python3 -I -c "import sys,json; print(json.loads(open('$PLAYBOOK_EVAL_CONFIG').read()).get('gate_echo','on'))" 2>/dev/null || echo "on")
    EVAL_NUDGES=$(python3 -I -c "import sys,json; print(json.loads(open('$PLAYBOOK_EVAL_CONFIG').read()).get('nudges','typed'))" 2>/dev/null || echo "typed")
    echo "⚠ EVAL MODE: gate_echo=${EVAL_GATE_ECHO}, nudges=${EVAL_NUDGES}" >&2
    # Write file-based marker for harness verification (stream-json doesn't capture hook output)
    echo "gate_echo=${EVAL_GATE_ECHO},nudges=${EVAL_NUDGES}" > "$AGENT_DIR/eval-marker" 2>/dev/null || true
fi

# Gate-logging write-failure tracking (bug report #4): a write that fails AFTER
# the AGENT_WRITABLE probe (e.g. a transient lock on the counter mv, or a
# non-writable session dir) silently freezes the gate_key and stops gate
# logging with no error. write_counter (gate-echo-lib) flips this flag instead
# of dying; we guard the mkdir + gate-log appends the same way and surface it
# below. Exported so the sourced lib's assignment is visible here.
PLAYBOOK_WRITE_FAILED=false
SESSION_DIR="$AGENT_DIR/sessions/$SESSION_ID"
# A session directory that is a link is not this session's (task 194, measured: the
# pointer and the counts were written into the link's target, and the gate read there
# was logged again at every call). Nothing is written or counted; the stop hook holds
# its low-activity releases on such a directory (task 193).
if ! _pb_session_dir_ok "$SESSION_DIR"; then     # it, or `.agent/sessions` itself (task 194, impl panel r1)
    # The write log is not session state (it lives under HOME; write_log.py checks its sink): an
    # Edit/Write is still recorded (impl panel r2, fable — the stop had switched it off).
    if [ "$AGENT_WRITABLE" = true ] && [ "$PB_HOOK_EVENT" = PostToolUse ]; then
        case "$TOOL_NAME" in Edit|Write) write_log_append "$INPUT" "$PROJECT_DIR" ;; esac
    fi
    printf '{"hookSpecificOutput":{"hookEventName":"%s","additionalContext":"# ⚠ this session'"'"'s directory under .agent/sessions/ (or .agent/sessions itself) is a link — not written, not counted (the stop hook holds this turn like one that wrote)."}}\n' "$PB_HOOK_EVENT"
    exit 0
fi
# Task 192 (#41): only where this hook may write. On a fresh multi-user clone
# AGENT_DIR is the ROOT `.agent` and the mkdir left an empty sessions/<id>/ there on
# every call; task-gate-hook and session-start-hook already skip it in that shape.
if [ "$AGENT_WRITABLE" = true ]; then
    mkdir -p "$SESSION_DIR" 2>/dev/null || PLAYBOOK_WRITE_FAILED=true
fi
STATE_FILE="$SESSION_DIR/current_state"
COUNTER_FILE="$SESSION_DIR/counters"

# F19: record this session's OWN transcript path (hook payloads carry it) so
# the monitor binds to the exact file instead of guessing by mtime — the
# batch-6 defect: the monitor tailed a stale conversation for 40 minutes while
# the real session streamed into another file. Refreshed every tool call, so a
# rollover (compaction hands the session a new transcript file) updates the
# pointer and the sensor's --pointer-file re-resolve follows it. A value with
# a newline is refused (one path, one line — no pointer-file injection).
if [ -n "$PB_FUSED" ]; then
    # The fused extraction carries the same sanitization: a value with a newline
    # is dropped there, so it can never reach the one-line pointer file.
    TRANSCRIPT_PATH="$PB_TRANSCRIPT"
else
TRANSCRIPT_PATH=$(echo "$INPUT" | python3 -I -c "
import sys, json
t = json.loads(sys.stdin.read()).get('transcript_path', '')
print(t if isinstance(t, str) and t and '\n' not in t and '\r' not in t else '')
" 2>/dev/null || echo "")
fi
# Never through a link or into a FIFO, nor inside a linked session directory (task 194;
# tasks 192/193 measured the class: a link was written through, a FIFO held the hook).
if [ -n "$TRANSCRIPT_PATH" ] && [ "$AGENT_WRITABLE" = true ] \
   && _pb_sink_ok "$SESSION_DIR" "$SESSION_DIR/transcript_path"; then
    printf '%s\n' "$TRANSCRIPT_PATH" > "$SESSION_DIR/transcript_path" 2>/dev/null || true
fi

# Increment tool/write counters
PB_NOT_COUNTED=false
if [ "$AGENT_WRITABLE" = true ]; then
    # read_counter_int (not read_counter): the counter bytes are untrusted and
    # `$(( ))` executes command substitution embedded in an operand (C5).
    # Read and write under ONE hold of the counters lock (task 182): the hooks of
    # tool calls the host ran side by side each read the same number and wrote
    # the same number plus one — 40 calls two at a time were counted as 20.
    counters_lock "$COUNTER_FILE"
    PB_NOT_COUNTED=$PLAYBOOK_COUNTERS_UNLOCKED       # true: this call's count is not made
    TOOLS_VAL=$(read_counter_int "$COUNTER_FILE" tools)
    write_counter "$COUNTER_FILE" tools $(( TOOLS_VAL + 1 ))
    # A write is every tool that edits a file, and Bash. MultiEdit and
    # NotebookEdit were counted as tools but not as writes until task 173, so a
    # turn whose only act was one of them read to the stop hook as a chat reply
    # — and its rule for a turn a notification started is "no write".
    # A FAILED call (task 196) is a write only when it was a shell call — what it did before failing is unknown; a
    # failed Edit/Write changed nothing (impl panel r1 I5, fable).
    PB_WRITE_TOOLS="Edit|Write|MultiEdit|NotebookEdit|Bash"
    [ "$PB_HOOK_EVENT" = PostToolUseFailure ] && PB_WRITE_TOOLS="Bash"
    case "|$PB_WRITE_TOOLS|" in
        *"|$TOOL_NAME|"*)
            WRITES_VAL=$(read_counter_int "$COUNTER_FILE" writes)
            write_counter "$COUNTER_FILE" writes $(( WRITES_VAL + 1 ))
            ;;
    esac
    counters_unlock
    # Write log: persist file content after Write/Edit — a call that succeeded (a failed Write wrote nothing)
    if [ "$PB_HOOK_EVENT" = PostToolUse ]; then
        case "$TOOL_NAME" in
            Edit|Write)
                write_log_append "$INPUT" "$PROJECT_DIR"
                ;;
        esac
    fi
fi
# A failed call: counted above, no gate echo (task 196).
if [ "$PB_HOOK_EVENT" = PostToolUseFailure ]; then
    exit 0
fi

# --- What the echo says, and when (task 219; PHASE-B item 2, the owner 2026-10-16 09:36: "La schimbare + amintire
# (Recomandat)") -----------------------------------------------------------------------------------------------
# The full echo is printed when something changed: the open gate — known by its place among the live gates, its
# text and the gate after it, read fence-aware by `scripts/task-status.py --echo`, never by its line — or the task,
# or a warning is due; at a session's first call; and after a SessionStart (a compaction), which leaves the
# `echo_reset` marker. On the same gate one line every 10 calls; otherwise `{}`. Always in full: eval mode, a lock not
# given, an `.agent` that cannot be written, gates that could not be read, and a subagent's call (a payload with
# `agent_id`: it has its own context — it is shown the gate and changes nothing, so the main agent's next call still
# sees what changed). The memory — `gate_echo_key`, `gate_echo_claim`, `gate_echo_quiet`, `gate_`-prefixed so a
# prompt's `reset_counters` keeps them — is kept in the counters.
#
# No python3 runs while the counters lock is held (task 182: the other calls' hooks wait for its two short steps
# only). So the gates are read BEFORE the hold, with the previous gate as the counters held it then; inside the hold
# both are checked again — a hook that overtook this one, or an edit of task.md in between, makes this call's read
# STALE: it is counted on the stored gate and says nothing, and the next call reads afresh.
#
# A change is delivered once and not lost (impl round 1, codex / grok): the call that will print it CLAIMS it in the
# hold (`gate_echo_claim` = its key + this hook's pid; the side-by-side calls stay quiet), and the key is acknowledged
# in a second short hold only after the print. A claim whose hook died is printed again by the next call, and the
# one-shot lines (the transition, the skip and bare-tick warnings) wait in `echo_pending` until they are printed.
PB_SUBAGENT_RE='"agent_id"[[:space:]]*:[[:space:]]*"[^"]'
PB_SUBAGENT=false
[[ "$INPUT" =~ $PB_SUBAGENT_RE ]] && PB_SUBAGENT=true
PB_REMEMBER=true
if [ "$AGENT_WRITABLE" != true ] || [ "$PB_SUBAGENT" = true ] \
   || { [ -n "$PLAYBOOK_EVAL_CONFIG" ] && [ -f "$PLAYBOOK_EVAL_CONFIG" ]; }; then
    PB_REMEMBER=false
fi
ECHO_RESET_FILE="$SESSION_DIR/echo_reset"
ECHO_PENDING_FILE="$SESSION_DIR/echo_pending"
PB_GATE_PENDING=false
PB_PENDING_TEXT=""
PB_CLAIMED=false                    # this call's claim was stored (only then is it checked before the print)

# _pb_json TEXT — the hook's JSON line on stdout; non-zero and nothing printed when it cannot be built
_pb_json() {
    local j
    j=$(printf '%s' "$1" | python3 -I -c "import sys,json; print(json.dumps(sys.stdin.buffer.read().decode('utf-8','replace').rstrip()))" 2>/dev/null) || j=""
    [ -n "$j" ] || return 1
    printf '{"hookSpecificOutput":{"hookEventName":"PostToolUse","additionalContext":%s}}\n' "$j"
}

# _pb_warned — 0 when this call has a warning to say (each forces the full echo)
_pb_warned() {
    [ "${PLAYBOOK_SANDBOXED:-}" != "1" ] || return 1
    [ "$PLAYBOOK_WRITE_FAILED" = true ] || [ "$PB_GATE_PENDING" = true ] || [ "$PLAYBOOK_COUNTERS_UNLOCKED" = true ]
}

# _pb_warnings TEXT — TEXT with the warnings this call must say appended
_pb_warnings() {
    local c="$1"
    # Loud gate-logging write-failure warning (bug report #4): a silent freeze of the gate state is how gate logging
    # died undetected on one machine. Not inside a sandboxed judge, whose read-only project fails these writes by design.
    if [ "$PLAYBOOK_WRITE_FAILED" = true ] && [ "${PLAYBOOK_SANDBOXED:-}" != "1" ]; then
        c="${c}
# ⚠ gate-logging write FAILED — session state / gate history not updated (retro attribution will degrade). Run \`tasks doctor\` and check .agent dir writability + AV locks."
    fi
    # A completed gate whose entry could not be written yet because the CHAT LOG's lock was held (ours was given):
    # said at every call it stays so — "not yet" has no end of its own (post-panel run 2).
    if [ "$PB_GATE_PENDING" = true ] && [ "$PLAYBOOK_COUNTERS_UNLOCKED" != true ] && [ "${PLAYBOOK_SANDBOXED:-}" != "1" ]; then
        c="${c}
# ⚠ the gate you completed is not logged yet — the chat log's lock is held by another process; the next tool call tries again."
    fi
    # There is a counters lock and it was not given (task 182) — say WHICH step went without: the count (the stop
    # hook then holds the turn) or only the gate step after a count that was made.
    if [ "$PLAYBOOK_COUNTERS_UNLOCKED" = true ] && [ "${PLAYBOOK_SANDBOXED:-}" != "1" ]; then
        if [ "$PB_NOT_COUNTED" = true ]; then
            c="${c}
# ⚠ the session's counters lock could not be taken within ${PLAYBOOK_COUNTERS_WAITED}s — this call was NOT counted, and the stop hook holds this turn like one that wrote, until your next prompt."
        else
            c="${c}
# ⚠ the session's counters lock could not be taken again within this call's ${PLAYBOOK_COUNTERS_WAITED}s — the call is counted; the gate was not looked at, the next call does that."
        fi
    fi
    printf '%s' "$c"
}

# _pb_proc_start PID — the process's start time (/proc/<pid>/stat field 22), nothing when it is gone. Read after the
# last ")": the command name may hold spaces and parentheses.
_pb_proc_start() {
    local st rest
    case "$1" in ''|*[!0-9]*) return 0 ;; esac
    st=$(cat "/proc/$1/stat" 2>/dev/null) || return 0
    rest=${st##*) }
    set -- $rest
    printf '%s' "${20:-}"
}
# _pb_alive PID START — 0 while that process exists AND is the one that started at START (task 220, grok: a bare
# `kill -0` took a recycled pid, or another user's process, for the claimer)
_pb_alive() {
    [ -n "$2" ] || return 1
    [ "$(_pb_proc_start "$1")" = "$2" ]
}
PB_SELF_START=$(_pb_proc_start $$)
PB_SELF_CLAIM_TAIL="$$ ${PB_SELF_START:-0}"

# _pb_decide KEY FORCE — inside the counters hold: PB_MODE full / reminder / quiet, and PB_MEMORY the memory fields
# to write with the gate (`write_counters` pairs). A full echo CLAIMS its key; the key itself is acknowledged after the
# print (`_pb_print`).
_pb_decide() {
    local key="$1" force="$2" quiet claim
    PB_MODE=full
    PB_MEMORY=()
    if [ "$PB_REMEMBER" != true ] || [ "$PLAYBOOK_COUNTERS_UNLOCKED" = true ]; then
        return 0
    fi
    claim=$(read_counter "$COUNTER_FILE" gate_echo_claim)
    local ckey="" cpid="" cstart="" live=false
    if [ -n "$claim" ]; then
        ckey=${claim% * *}
        cstart=${claim##* }
        cpid=${claim% *}
        cpid=${cpid##* }
        if [ "$cpid" != "$$" ] && _pb_alive "$cpid" "$cstart"; then live=true; fi
    fi
    # one-shot lines that wait to be printed, and no live hook printing them: this call prints them (task 220, C1 —
    # a skip keeps the key, so "the key changed" never brought them back)
    if [ -f "$ECHO_PENDING_FILE" ] && [ ! -L "$ECHO_PENDING_FILE" ] && [ -s "$ECHO_PENDING_FILE" ] && [ "$live" != true ]; then
        force=true
    fi
    quiet=$(( $(read_counter_int "$COUNTER_FILE" gate_echo_quiet) + 1 ))
    if [ "$force" != true ] && [ ! -e "$ECHO_RESET_FILE" ] && [ ! -L "$ECHO_RESET_FILE" ]; then
        if [ "$(read_counter "$COUNTER_FILE" gate_echo_key)" = "$key" ] \
           || { [ "$ckey" = "$key" ] && [ "$live" = true ]; }; then
            # the same gate (or one a live side-by-side hook is printing): quiet, or the reminder at 10
            if [ "$quiet" -ge 10 ]; then
                PB_MODE=reminder
                PB_MEMORY=(gate_echo_quiet 0)
            else
                PB_MODE=quiet
                PB_MEMORY=(gate_echo_quiet "$quiet")
            fi
            return 0
        fi
    fi
    PB_MEMORY=(gate_echo_claim "$key $PB_SELF_CLAIM_TAIL" gate_echo_quiet 0)
    return 0
}

# _pb_print KEY TEXT — after the hold: print TEXT for PB_MODE full / reminder (`{}` for quiet); a full echo printed is
# acknowledged (its key kept, its claim and the pending one-shot lines cleared) in a second short hold; one that could
# not be made gives its claim back, so the next call prints it — with the pending lines (plan panel, opus / sonnet;
# impl round 1, codex / grok)
_pb_print() {
    local key="$1" text="$2" out=""
    if [ "$PB_MODE" != quiet ]; then
        out=$(_pb_json "$text") || out=""
    fi
    if [ "$PB_MODE" = full ] && [ "$PB_CLAIMED" = true ]; then
        # the claim is checked, the answer printed and acknowledged in ONE hold — printf only, no python (task 220,
        # C4: a hook that lost its claim while making its answer printed its older state)
        counters_lock "$COUNTER_FILE"
        if [ "$PLAYBOOK_COUNTERS_UNLOCKED" != true ] \
           && [ "$(read_counter "$COUNTER_FILE" gate_echo_claim)" = "$key $PB_SELF_CLAIM_TAIL" ]; then
            if [ -n "$out" ]; then
                printf '%s\n' "$out"
                write_counters "$COUNTER_FILE" gate_echo_key "$key" gate_echo_claim ""
                rm -f -- "$ECHO_PENDING_FILE" "$ECHO_RESET_FILE" 2>/dev/null || true
            else
                echo '{}'
                write_counters "$COUNTER_FILE" gate_echo_claim ""
            fi
        else
            echo '{}'                       # superseded: the hook that holds the claim prints the newer state
        fi
        counters_unlock
        return 0
    fi
    if [ -n "$out" ]; then
        printf '%s\n' "$out"
    else
        echo '{}'
        if [ "$PB_MODE" = reminder ] && [ "$PB_REMEMBER" = true ] && [ "$PLAYBOOK_COUNTERS_UNLOCKED" != true ]; then
            # a reminder that could not be made: the next call gives it (task 220, grok)
            counters_lock "$COUNTER_FILE"
            write_counters "$COUNTER_FILE" gate_echo_quiet 9
            counters_unlock
        fi
    fi
    return 0
}

# Read task number
TASK=""
if [ -f "$STATE_FILE" ]; then
    TASK=$(head -1 "$STATE_FILE" | tr -d '[:space:]')
fi
# N2: a non-digit pointer (incl. a glob metachar) is not a valid task number;
# blank it so it reads as "no active task" rather than glob-matching a real one.
case "$TASK" in *[!0-9]*) TASK="" ;; esac

if [ -z "$TASK" ]; then
    PB_CORE="# No active task (.claude/bin/tasks work <N> to activate)"
    if [ "$AGENT_WRITABLE" = true ] && [ "$PB_SUBAGENT" != true ]; then
        counters_lock "$COUNTER_FILE"
    fi
    PB_FORCE=false
    if _pb_warned; then PB_FORCE=true; fi
    _pb_decide "no-task" "$PB_FORCE"
    if [ "${#PB_MEMORY[@]}" -gt 0 ]; then
        write_counters "$COUNTER_FILE" "${PB_MEMORY[@]}"
        if [ "$PLAYBOOK_WRITE_FAILED" = true ] && [ "$PB_MODE" != full ]; then PB_MODE=full; fi
        if [ "$PLAYBOOK_WRITE_FAILED" != true ] && [ "${PB_MEMORY[0]}" = gate_echo_claim ]; then PB_CLAIMED=true; fi
    fi
    if [ "$PB_MODE" = full ] && [ "$PB_REMEMBER" = true ] && [ -f "$ECHO_PENDING_FILE" ] && [ ! -L "$ECHO_PENDING_FILE" ]; then
        # one-shot lines a dead or failed hook left are said here too before the acknowledgement clears them
        # (task 220, impl round 1, grok)
        PB_PENDING_TEXT=$(cat -- "$ECHO_PENDING_FILE" 2>/dev/null || true)
        if [ -n "$PB_PENDING_TEXT" ]; then
            PB_CORE="${PB_PENDING_TEXT}
${PB_CORE}"
        fi
    fi
    counters_unlock
    if [ "$PB_MODE" = full ]; then
        _pb_print "no-task" "$(_pb_warnings "$PB_CORE")"
    else
        _pb_print "no-task" "$PB_CORE"
    fi
    exit 0
fi

# Find task file matching the task number — a fault, said at every call
TASK_FILE=$(task_record_file "$AGENT_DIR" "$TASK")
if [ -z "$TASK_FILE" ]; then
    _pb_json "# [${TASK}] — task file not found" || echo '{}'
    exit 0
fi

# _pb_prev — the gate the counters hold (the one the echo saw last), one line: task, position, below, the open copies
# of its text, its checked matches and those above its first open copy (task 220), line, text — split by US (0x1f), never a tab: a tab is a whitespace
# IFS character, so `read` would drop an empty field (an empty task read the next field, "0", as the task — measured). The count is not in it (impl round
# 1, opus: a stale call counts on the stored gate, which would make every other call of the burst stale too).
_pb_prev() {
    local t
    t=$(read_counter "$COUNTER_FILE" gate_task)
    case "$t" in *[!0-9]*) t="" ;; esac
    printf '%s\x1f%s\x1f%s\x1f%s\x1f%s\x1f%s\x1f%s\x1f%s' "$t" "$(read_counter_int "$COUNTER_FILE" gate_pos)" \
        "$(read_counter_int "$COUNTER_FILE" gate_below)" "$(read_counter_int "$COUNTER_FILE" gate_opens)" \
        "$(read_counter_int "$COUNTER_FILE" gate_checks)" "$(read_counter_int "$COUNTER_FILE" gate_above)" \
        "$(read_counter_int "$COUNTER_FILE" gate_line)" "$(read_counter "$COUNTER_FILE" gate_text)"
}
PB_PREV_SEEN=$(_pb_prev)
IFS=$'\x1f' read -r PREV_TASK PREV_POS PREV_BELOW PREV_OPENS PREV_CHECKS PREV_ABOVE PREV_LINE PREV_TEXT <<< "$PB_PREV_SEEN" \
    || true
PB_ECHO_ARGS=()
if [ -n "$PREV_TASK" ] && [ "$PREV_TASK" = "$TASK" ]; then
    PB_ECHO_ARGS=("$PREV_POS" "$PREV_BELOW" "$PREV_OPENS" "$PREV_CHECKS" "$PREV_ABOVE" "$PREV_TEXT")
fi

# The gates, read the way the CLI reads them (fence-aware, physical lines) — one spawn, before the hold. The file's
# identity is taken first: if it is not the same inside the hold, this read is stale.
PB_FILE_SEEN=$(stat -c '%i %s %y' -- "$TASK_FILE" 2>/dev/null || true)
PB_GATES_OK=true
PB_ECHO_OUT=$(python3 -E -s "$HOOK_DIR/task-status.py" --echo "$TASK_FILE" "${PB_ECHO_ARGS[@]}" 2>/dev/null) \
    || PB_GATES_OK=false
TOTAL_GATES=""; DONE_GATES=""; GATE_LINE=""; GATE_POS=""; GATE_BELOW=""; TRANS=""; TICKED_LINE=""
GATE_TEXT_FULL=""; GATE_TEXT=""; PB_SHORT=""; GATE_OPENS=""; GATE_CHECKS=""; GATE_ABOVE=""
{
    IFS= read -r TOTAL_GATES || true
    IFS= read -r DONE_GATES || true
    IFS= read -r GATE_LINE || true
    IFS= read -r GATE_POS || true
    IFS= read -r GATE_BELOW || true
    IFS= read -r TRANS || true
    IFS= read -r TICKED_LINE || true
    IFS= read -r GATE_TEXT_FULL || true
    IFS= read -r GATE_TEXT || true
    IFS= read -r PB_SHORT || true
    IFS= read -r GATE_OPENS || true
    IFS= read -r GATE_CHECKS || true
    IFS= read -r GATE_ABOVE || true
} <<< "$PB_ECHO_OUT"
case "$TRANS" in none|same|skip|done|done-bare|moved|reworded) ;; *) PB_GATES_OK=false ;; esac
if [ "$PB_GATES_OK" != true ]; then
    # Nothing is decided on gates that could not be read: no entry, no memory, the warning at every call.
    _pb_json "$(_pb_warnings "# ⚠ [${TASK}] the task's gates could not be read (scripts/task-status.py --echo failed) — no gate echo this call.")" \
        || echo '{}'
    exit 0
fi
TOTAL_GATES=$(_safe_int "$TOTAL_GATES"); DONE_GATES=$(_safe_int "$DONE_GATES"); GATE_BELOW=$(_safe_int "$GATE_BELOW")
case "$GATE_LINE" in *[!0-9]*) GATE_LINE="" ;; esac
case "$TICKED_LINE" in *[!0-9]*) TICKED_LINE="" ;; esac
case "$GATE_POS" in ''|*[!0-9]*) GATE_POS=-1 ;; esac

# Freehand mode: suppress drift counter and gate pressure when the gate text
# starts with "Freehand" — covers "Freehand", "Freehand — work is done",
# "Freehand debrief — ...", and other discussion-style variants observed in
# real task.md files. The single exception is "Freehand log" (the cleanup
# gate inserted by `tasks freehand` workflow at cli.py:1620), which must
# remain a normal blocking gate so its work runs before close.
# Pattern stays in lockstep with scripts/stop-hook and src/provider/codex_hooks.py.
IS_FREEHAND=false
# Match `Freehand log` followed by ANY non-word char (or end of string) — exact
# Python regex `\b` semantics (impl-review F2/F5).
if [ -n "$GATE_LINE" ]; then
    case "$GATE_TEXT_FULL" in
        "Freehand log"|"Freehand log"[!a-zA-Z0-9_]*)
            : # cleanup gate — NOT freehand-mode
            ;;
        Freehand*)
            IS_FREEHAND=true
            ;;
    esac
fi

# Make path relative to project
REL_PATH="${TASK_FILE#$PROJECT_DIR/}"

# What the echo would say, and its key (outside the hold: nothing that can be done before it is done in it)
PB_SUM=$(printf '%s' "$GATE_TEXT_FULL" | cksum | tr ' ' '.')
if [ "$IS_FREEHAND" = true ]; then
    PB_CORE="# [${TASK}] Freehand mode — wait for user instructions. Close only when user says done."
    PB_KEY="freehand|${TASK}|${GATE_POS}|${PB_SUM}"
    PB_REMINDER="$PB_CORE"
elif [ -n "$GATE_LINE" ]; then
    PB_CORE=$(format_context "$TASK" "$DONE_GATES" "$TOTAL_GATES" "${GATE_TEXT}" "$GATE_LINE" "$REL_PATH")
    PB_KEY="gate|${TASK}|${GATE_POS}|${PB_SUM}"
    if [ "$PB_SHORT" != "$GATE_TEXT_FULL" ]; then PB_SHORT="${PB_SHORT}…"; fi
    PB_REMINDER="# [${TASK}] still at gate ${DONE_GATES}/${TOTAL_GATES}: ${PB_SHORT} — ${REL_PATH}:${GATE_LINE}"
else
    PB_CORE=$(format_context "$TASK" "$DONE_GATES" "$TOTAL_GATES" "" "" "$REL_PATH")
    PB_KEY="done|${TASK}"
    PB_REMINDER="$PB_CORE"
fi

# A subagent's call is shown the gate as it stands and changes nothing — no entry, no gate written, no memory (impl
# round 1, grok / opus): the change stays for the main agent's next call to see and log.
if [ "$PB_SUBAGENT" = true ]; then
    _pb_json "$(_pb_warnings "$PB_CORE")" || echo '{}'
    exit 0
fi

# The entry and the new gate go together or not at all (task 182): the entry is appended under the chat log's lock —
# the one `tasks tag` and the chat-log hook use (task 058) — which is TRIED, not waited for, under ours; where it is
# not given, or ours was not, NOTHING is written and the gate is not advanced: the next call finds the old gate and
# tries again. Since task 220 that lock is taken BEFORE the decision, held over the counters write, and the entry is
# appended only once the counters were written (impl round 1, grok: an entry appended before a counters write that
# failed was appended again by the retry).
_gate_append() {
    {
        echo "---"
        echo ""
        echo "**[G${PREV_TASK}:${PREV_LINE}]** [$(date -u '+%Y-%m-%d %H:%M:%S UTC')] \`HOST\` (${PREV_COUNT} tool calls)"
        echo ""
        case "$ENTRY_KIND" in
            switch) echo "- [ ] ${PREV_TEXT} (left open — switched to task ${TASK})" ;;
            moved)  echo "- [ ] ${PREV_TEXT} (left open — the open gate changed)" ;;
            *)      echo "- [x] ${PREV_TEXT}" ;;
        esac
        echo ""
    } >> "$GATE_LOG" 2>/dev/null
}
PB_CHATLOG_HELD=false
# _pb_chatlog_take — 0: the entry may be written (the lock is held, or this host has no lock to take); 3: not yet
# (the lock is held by another process, or ours was not given); 4: the lock file cannot be opened (said as a write
# failure; the gate moves on without its entry, as before)
_pb_chatlog_take() {
    [ "$PLAYBOOK_COUNTERS_UNLOCKED" != true ] || return 3
    # (a host whose `flock` cannot wait with a limit has no lock to take: the entry is appended without one)
    if command -v flock &>/dev/null && [ "$_PB_COUNTERS_NOLOCK" != true ]; then
        { exec 202>"$AGENT_DIR/chat_log_counter.lock"; } 2>/dev/null || return 4
        if ! flock -n 202 2>/dev/null; then
            { exec 202>&-; } 2>/dev/null || true
            return 3
        fi
        PB_CHATLOG_HELD=true
    fi
    return 0
}
_pb_chatlog_give() {
    if [ "$PB_CHATLOG_HELD" = true ]; then
        { exec 202>&-; } 2>/dev/null || true
        PB_CHATLOG_HELD=false
    fi
    return 0
}

# --- The hold: the read checked again, the entry, the new gate and the memory in one write ----------------------
if [ "$AGENT_WRITABLE" = true ]; then
    counters_lock "$COUNTER_FILE"
    # a stale read is only judged where the memory is kept: eval mode prints every call (task 220, opus)
    if [ "$PB_REMEMBER" = true ] && [ "$PLAYBOOK_COUNTERS_UNLOCKED" != true ] \
       && { [ "$(_pb_prev)" != "$PB_PREV_SEEN" ] \
            || [ "$(stat -c '%i %s %y' -- "$TASK_FILE" 2>/dev/null || true)" != "$PB_FILE_SEEN" ]; }; then
        # STALE: counted on the gate the counters hold now, nothing said, nothing logged. The quiet count stops at 9
        # here (impl round 1, codex: a burst pushed it to 12 with no reminder) — the next fresh call gives the reminder.
        PB_NOW_TASK=$(read_counter "$COUNTER_FILE" gate_task)
        if [ -n "$PB_NOW_TASK" ]; then
            PB_NOW_QUIET=$(( $(read_counter_int "$COUNTER_FILE" gate_echo_quiet) + 1 ))
            if [ "$PB_NOW_QUIET" -gt 9 ]; then PB_NOW_QUIET=9; fi
            write_counters "$COUNTER_FILE" gate_count "$(( $(read_counter_int "$COUNTER_FILE" gate_count) + 1 ))" \
                gate_echo_quiet "$PB_NOW_QUIET"
        fi
        counters_unlock
        if [ "$PLAYBOOK_WRITE_FAILED" = true ] && [ "${PLAYBOOK_SANDBOXED:-}" != "1" ]; then
            # a write failed in this call (its count, or here): said, never a quiet call (task 220, sonnet, grok)
            _pb_json "$(_pb_warnings "$PB_CORE")" || echo '{}'
        else
            echo '{}'
        fi
        exit 0
    fi
fi
# The count of calls on the gate is read under the lock (a count read before it lost the side-by-side increments —
# measured: 7 of 15)
PREV_COUNT=$(read_counter_int "$COUNTER_FILE" gate_count)
# The transition from the gate the echo saw last. Only the previous gate's own line, now checked, is a completion
# (`[x]` in chat_log); a gate added, moved or unticked above it is "left open"; a reworded gate is the same gate.
GATE_LOG="$AGENT_DIR/chat_log.md"
TRANSITION_MSG=""
SKIP_MSG=""
BARE_MSG=""
ENTRY_KIND=""
NEW_COUNT=1
if [ "$IS_FREEHAND" = true ]; then
    # Freehand mode: no counter increment, no repeat warning, no transition logging
    NEW_COUNT=0
elif [ -n "$PREV_TASK" ] && [ "$PREV_TASK" != "$TASK" ]; then
    # task 073 (C10): a TASK SWITCH is not a completion — the entry says the gate was left open
    ENTRY_KIND=switch
    TRANSITION_MSG="# ↷ switched from task ${PREV_TASK} — its gate was left open (${PREV_COUNT} tool calls)"
elif [ -n "$PREV_TASK" ]; then
    case "$TRANS" in
        same|reworded)
            NEW_COUNT=$(( PREV_COUNT + 1 ))
            ;;
        skip)
            NEW_COUNT=$(( PREV_COUNT + 1 ))
            SKIP_MSG="
# ⚠ A gate below the open one (line ${GATE_LINE}) was checked while it stays open — reorder the gates in task.md if you are working out of order."
            ;;
        done|done-bare)
            ENTRY_KIND=done
            TRANSITION_MSG="# ✓ previous gate done (${PREV_COUNT} tool calls)"
            if [ "$TRANS" = done-bare ]; then
                BARE_MSG="
# ⚠ Gate closed with bare checkmark — append your outcome. (line ${TICKED_LINE})"
            fi
            ;;
        moved)
            ENTRY_KIND=moved
            TRANSITION_MSG="# ↻ the open gate changed — no gate was ticked (${PREV_COUNT} tool calls on the one before)"
            ;;
    esac
fi

PB_ENTRY_WRITE=false
if [ -n "$ENTRY_KIND" ] && [ "$AGENT_WRITABLE" = true ]; then
    if ! _pb_sink_ok "" "$GATE_LOG" || ! _pb_sink_ok "" "$AGENT_DIR/chat_log_counter.lock"; then
        # a chat log or its lock that is a link or not a regular file is not ours (task 194): the entry is not
        # written — said as the write failure it is — and the gate moves on
        PLAYBOOK_WRITE_FAILED=true
    else
        PB_TAKE_RC=0
        _pb_chatlog_take || PB_TAKE_RC=$?
        case "$PB_TAKE_RC" in
            0) PB_ENTRY_WRITE=true ;;
            3) # not yet: nothing is told, nothing is written — as if this call had not seen the change
               PB_GATE_PENDING=true
               TRANSITION_MSG=""
               SKIP_MSG=""
               BARE_MSG=""
               NEW_COUNT=$PREV_COUNT ;;
            *) PLAYBOOK_WRITE_FAILED=true ;;
        esac
    fi
fi
PB_FORCE=false
if [ -n "$TRANSITION_MSG" ] || [ -n "$SKIP_MSG" ] || [ -n "$BARE_MSG" ] || _pb_warned; then
    PB_FORCE=true
fi
_pb_decide "$PB_KEY" "$PB_FORCE"
if [ "$PB_MODE" = full ] && [ "$PB_REMEMBER" = true ] && [ "$PLAYBOOK_COUNTERS_UNLOCKED" != true ]; then
    # one-shot lines not yet printed (a hook that claimed them died, or its print failed) come first
    if [ -f "$ECHO_PENDING_FILE" ] && [ ! -L "$ECHO_PENDING_FILE" ]; then
        PB_PENDING_TEXT=$(cat -- "$ECHO_PENDING_FILE" 2>/dev/null || true)
    fi
fi
PB_ONE_SHOT="${TRANSITION_MSG}${SKIP_MSG}${BARE_MSG}"
if [ "$AGENT_WRITABLE" = true ]; then
    # the one-shot lines are written to `echo_pending` FIRST, in this hold, so a hook killed right after storing the
    # gate cannot lose them (task 220, impl round 1, codex); they are put back as they were if the counters write fails
    # (sonnet: they piled up while writes failed)
    PB_PENDING_WRITTEN=false
    if [ "$PB_MODE" = full ] && [ "$PB_REMEMBER" = true ] && [ "$PLAYBOOK_COUNTERS_UNLOCKED" != true ] \
       && [ -n "$PB_ONE_SHOT" ] && [ "$PB_GATE_PENDING" != true ] && _pb_sink_ok "" "$ECHO_PENDING_FILE"; then
        if printf '%s' "${PB_PENDING_TEXT:+${PB_PENDING_TEXT}
}${PB_ONE_SHOT}" > "$ECHO_PENDING_FILE" 2>/dev/null; then
            PB_PENDING_WRITTEN=true
        fi
    fi
    PB_GATE_FIELDS=()
    if [ "$PB_GATE_PENDING" != true ]; then
        if [ -n "$GATE_LINE" ]; then
            PB_GATE_FIELDS=(gate_task "$TASK" gate_pos "$GATE_POS" gate_below "$GATE_BELOW"
                            gate_opens "$(_safe_int "$GATE_OPENS")" gate_checks "$(_safe_int "$GATE_CHECKS")"
                            gate_above "$(_safe_int "$GATE_ABOVE")" gate_text "$GATE_TEXT_FULL"
                            gate_line "$GATE_LINE" gate_count "$NEW_COUNT")
        else
            # All gates done — the final gate is logged below; clear the gate fields, keep tools/writes
            PB_GATE_FIELDS=(gate_task "" gate_pos "" gate_below "" gate_opens "" gate_checks "" gate_above ""
                            gate_text "" gate_line "" gate_count "")
        fi
    fi
    # the gate and the memory in ONE rewrite (impl round 1 of task 219, sonnet); whether THIS write failed is kept apart
    # from an earlier failure of the call, because only a stored gate may get its entry
    PB_FAILED_BEFORE=$PLAYBOOK_WRITE_FAILED
    PLAYBOOK_WRITE_FAILED=false
    if [ "${#PB_GATE_FIELDS[@]}" -gt 0 ] || [ "${#PB_MEMORY[@]}" -gt 0 ]; then
        write_counters "$COUNTER_FILE" "${PB_GATE_FIELDS[@]}" "${PB_MEMORY[@]}"
    fi
    PB_THIS_FAILED=$PLAYBOOK_WRITE_FAILED
    if [ "$PB_FAILED_BEFORE" = true ]; then PLAYBOOK_WRITE_FAILED=true; fi
    if [ "$PB_THIS_FAILED" = true ] && [ "$PB_PENDING_WRITTEN" = true ]; then
        if [ -n "$PB_PENDING_TEXT" ]; then
            printf '%s' "$PB_PENDING_TEXT" > "$ECHO_PENDING_FILE" 2>/dev/null || true
        else
            rm -f -- "$ECHO_PENDING_FILE" 2>/dev/null || true
        fi
    fi
    # a write that fails is said, never a quiet call (codex: a failing quiet-count write kept the warning hidden)
    if [ "$PLAYBOOK_WRITE_FAILED" = true ] && [ "$PB_MODE" != full ]; then
        PB_MODE=full
    fi
    if [ "$PB_THIS_FAILED" != true ] && [ "${PB_MEMORY[0]:-}" = gate_echo_claim ]; then
        PB_CLAIMED=true
    fi
    # the entry, only once the counters were written (task 220, grok)
    if [ "$PB_ENTRY_WRITE" = true ] && [ "$PB_THIS_FAILED" != true ]; then
        _gate_append || PLAYBOOK_WRITE_FAILED=true
    fi
    _pb_chatlog_give
fi
counters_unlock

# --- After the hold: the answer --------------------------------------------------------------------------------
if [ -n "$PLAYBOOK_EVAL_CONFIG" ]; then
    EVAL_MARKER="# [eval:gate_echo=${EVAL_GATE_ECHO},nudges=${EVAL_NUDGES}]"
fi
# Tool-type-aware nudge — on the reminder only (and in eval mode from the 2nd call on a gate, as before).
# Eval flags: off=no nudge, flat=old 19-item rotation, typed=current (default)
PB_NUDGE=""
if [ "$PB_MODE" != quiet ] && [ "$EVAL_NUDGES" != "off" ] && [ "$EVAL_GATE_ECHO" != "off" ] && [ -n "$GATE_LINE" ] \
   && [ "$IS_FREEHAND" != true ] && [ "$NEW_COUNT" -gt 1 ]; then
    TOOL_CLASS=$(classify_tool "$TOOL_NAME" "$INPUT")
    case "$TOOL_CLASS" in
        orient)  PB_NUDGE=" — 💭 ${NUDGES_ORIENT[$(( (NEW_COUNT - 2) % ${#NUDGES_ORIENT[@]} ))]}" ;;
        execute) PB_NUDGE=" — 💭 ${NUDGES_EXECUTE[$(( (NEW_COUNT - 2) % ${#NUDGES_EXECUTE[@]} ))]}" ;;
        test)    PB_NUDGE=" — 💭 ${NUDGES_TEST[$(( (NEW_COUNT - 2) % ${#NUDGES_TEST[@]} ))]}" ;;
        reflect) PB_NUDGE=" — 💭 ${NUDGES_REFLECT[$(( (NEW_COUNT - 2) % ${#NUDGES_REFLECT[@]} ))]}" ;;
        # operate: silent — no nudge
    esac
fi
if [ "$PB_MODE" = reminder ]; then
    _pb_print "$PB_KEY" "${PB_REMINDER}${PB_NUDGE}"
    exit 0
fi
# The full echo: the one-shot lines first — those a dead hook left (PB_PENDING_TEXT) and this call's transition —
# then the gate, then this call's skip / bare-tick warnings.
PB_FULL="$PB_CORE"
if [ -n "$TRANSITION_MSG" ]; then
    PB_FULL="${TRANSITION_MSG}
${PB_FULL}"
fi
if [ -n "$PB_PENDING_TEXT" ]; then
    # a line this call says itself is said once (a hook killed after writing it, the change seen again — task 220)
    PB_PENDING_KEPT=""
    while IFS= read -r PB_LN; do
        [ -n "$PB_LN" ] || continue
        case "$TRANSITION_MSG$SKIP_MSG$BARE_MSG" in *"$PB_LN"*) continue ;; esac
        PB_PENDING_KEPT="${PB_PENDING_KEPT:+${PB_PENDING_KEPT}
}${PB_LN}"
    done <<< "$PB_PENDING_TEXT"
    if [ -n "$PB_PENDING_KEPT" ]; then
        PB_FULL="${PB_PENDING_KEPT}
${PB_FULL}"
    fi
fi
PB_FULL="${PB_FULL}${SKIP_MSG}${BARE_MSG}"
if [ -n "$EVAL_MARKER" ]; then
    # Eval mode: the echo as it was before task 219 — every call, the nudge from the 2nd call on a gate
    if [ "$EVAL_GATE_ECHO" = "off" ]; then
        PB_FULL="$EVAL_MARKER"
    else
        PB_FULL="${EVAL_MARKER}
${PB_FULL}${PB_NUDGE}"
    fi
fi
_pb_print "$PB_KEY" "$(_pb_warnings "$PB_FULL")"
