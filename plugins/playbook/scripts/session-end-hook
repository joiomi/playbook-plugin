#!/bin/bash
_PB_HJ_T0=$EPOCHREALTIME     # the hook journal's start (task 222): first, before anything else runs
# session-end-hook
# SessionEnd hook — cleans up per-session state directory.
#
# Parses session_id from stdin JSON, removes .agent/sessions/<session_id>/.

set -e

# Skip when invoked from the monitor's own claude session (see launch-monitor).
# Log to stderr so the hook's firing is still visible; only gate-enforcement skipped.
if [ "${PLAYBOOK_ROLE:-}" = "monitor" ]; then
    echo "[$(basename "$0")] skip (PLAYBOOK_ROLE=monitor)" >&2
    exit 0
fi

# The Python floor (task 192, #46), advisory: below 3.10 say so and delete nothing —
# an interpreter fault must never cost a session's pointer; the liveness GC
# reclaims the directory once the session is gone. The launchers' probe.
if ! python3 -I -c 'import sys; sys.exit(0 if sys.version_info >= (3,10) else 1)' 2>/dev/null; then
    PB_PY_FOUND="$(python3 --version 2>/dev/null | head -1 | tr -cd 'A-Za-z0-9._ -')"
    echo "playbook: needs python3 >= 3.10 (found: ${PB_PY_FOUND:-no python3 on PATH}) — session cleanup skipped; upgrade python3" >&2
    # recorded in the hook journal too (task 222, plan panel codex I4): its writer needs no python
    { source "$(cd "$(dirname "$0")" && pwd)/gate-echo-lib.sh" && pb_hook_begin session-end; } 2>/dev/null || true
    PB_HJ_EVENT=SessionEnd; PB_HJ_DECISION=skip; PB_HJ_DETAIL="python < 3.10"
    exit 0
fi

# Source shared lib (same directory)
HOOK_DIR="$(cd "$(dirname "$0")" && pwd)"
source "$HOOK_DIR/gate-echo-lib.sh"
pb_hook_begin session-end    # one line per run in journal/hooks.jsonl (task 222)

# Find project root
PROJECT_DIR=$(find_project_root)
if [ -z "$PROJECT_DIR" ]; then
    exit 0
fi

AGENT_DIR=$(resolve_agent_dir "$PROJECT_DIR")

# Skip cleanup if .agent/ isn't writable (sandbox mode)
if ! agent_dir_writable "$PROJECT_DIR"; then
    exit 0
fi

# Session ID: resolve_session_id(), the SAME resolver every other hook uses
# (session-start-hook, task-gate-hook, state-echo-hook) and the Python CLI.
# This used to be `${PLAYBOOK_SESSION_ID:-pid-$PPID}` with a comment claiming it
# matched session-start-hook — it did not. When the env var fails to propagate
# (VSCode CLAUDE_ENV_FILE quirks, missing wrappers, subprocess loss) the ancestor
# scan returns pid-<root agent>, not pid-$PPID — so this hook could delete a directory that was
# never a session while leaving the real one behind (task 027).
INPUT=$(cat)
SESSION_ID="$(resolve_session_id)"

# Task 246 (PLAN.md "From task 244" (b)): the agent's tokens of the turn after the session's last Stop — a turn
# interrupted (Esc, or a session ended mid-turn) gets no Stop — are recorded here, for every end reason, before
# anything below can remove the session dir and its transcript pointer (agent_usage.py `hook`, as the Stop recorder
# runs it: the task is read inside the lane lock, an unresolved session records nothing; a busy lock with something
# unread leaves an `unknown` marker, since nothing reads this transcript after its end — a `/clear` included: the
# SessionStart that follows points the session at the new transcript, task 247 — PB_AU_MARK_BUSY). Its answer joins this hook's
# journal line. Never for a judge's or a tail-cert's session (the monitor's exited at the top); bounded to 3 s of the
# hook's 5, and best-effort: it never changes what this hook does or decides.
if [ -r "$HOOK_DIR/agent_usage.py" ]; then
    case "${PLAYBOOK_SESSION_ID:-}" in
        judge|tail-cert) ;;
        *) _pb_au_said=$(printf '%s' "$INPUT" | PB_AU_LANE="$AGENT_DIR" PB_AU_SESSION="$SESSION_ID" PB_AU_MARK_BUSY=1 \
               timeout 3 python3 -E -s "$HOOK_DIR/agent_usage.py" hook 2>/dev/null) || _pb_au_said="the recorder stopped"
           _pb_au_said="${_pb_au_said:0:120}"
           pb_on_exit 'PB_HJ_DETAIL="${PB_HJ_DETAIL:+$PB_HJ_DETAIL; }agent tokens: $_pb_au_said"' ;;
    esac
fi

# SessionEnd is registered with no matcher, so it fires for every reason —
# including ones where THE SAME PROCESS KEEPS RUNNING and SessionStart fires
# again with the same pid (`clear` certainly; interactive `/resume` reportedly).
# Deleting the session dir there silently deactivates the task mid-session: the
# pointer goes away, the dir is re-created empty, and task-gate-hook starts
# hard-blocking Edit/Write with "No active task" — the same failure the
# SessionStart GC used to cause (task 027). `/clear` discards the conversation,
# not the work; task.md is the source of truth and the on-disk pointer exists
# precisely to outlive context.
#
# DELETE ONLY ON AN EXPLICIT TERMINAL ALLOWLIST. The first version of this fix
# kept the pointer only for an exact `reason=clear` and fell through to deleting
# otherwise, reasoning that this preserved existing behaviour and "can only cost
# cleanup, never a live pointer" — which is backwards, as the review panel
# pointed out: an unparseable payload, a missing python3, a `Clear` case variant
# or any future rename lands on the DELETE path, so payload drift costs a live
# pointer and reintroduces the reported bug. Meanwhile a missed cleanup is now
# genuinely free: the liveness-based GC in session-start-hook reclaims the
# directory as soon as the pid is gone. So: unknown reason ⇒ KEEP.
END_REASON=$(printf '%s' "$INPUT" | python3 -I -c \
    "import sys,json; print(json.loads(sys.stdin.read()).get('reason',''))" 2>/dev/null || echo "")
# Case-fold so `Clear`/`LOGOUT` cannot slip through on either side.
END_REASON=$(printf '%s' "$END_REASON" | tr '[:upper:]' '[:lower:]')

case "$END_REASON" in
    logout|prompt_input_exit|other|exit)
        ;;                      # the process is going away — clean up
    *)
        PB_HJ_DETAIL="kept: reason ${END_REASON:-unknown}"
        exit 0 ;;               # clear, resume, unknown, unparseable — KEEP
esac

# Task 105: unresolved (under the Claude Code background daemon, no
# PLAYBOOK_SESSION_ID). `sessions/` + "" is the sessions dir ITSELF — the rm
# below would delete every session's pointer. Nothing to clean: exit.
if [ -z "$SESSION_ID" ]; then
    session_unresolved_notice
    PB_HJ_DECISION=skip; PB_HJ_DETAIL="no session"
    exit 0
fi

# Task 126 (owner Q-D (b), 2026-09-29; 106 P2, gauntlet 2 G2-21): a claude
# started from another claude's Bash resolves to the OUTER session's pid-N (the
# highest agent), and deleting here took the outer session's live pointer. Delete
# `pid-N` only when the exiting process IS N — the LOWEST agent in this hook's own
# chain. No agent visible (an unreadable chain) proves nothing: keep, as for an
# unknown reason above; the liveness GC reclaims dead dirs.
# Other ids (`judge`, a subagent's id) are not process ids: unchanged.
case "$SESSION_ID" in
    pid-*)
        _PB_LOWEST=$(_agent_walk all)
        _PB_LOWEST="${_PB_LOWEST%% *}"
        [ -n "$_PB_LOWEST" ] && [ "pid-$_PB_LOWEST" = "$SESSION_ID" ] || { PB_HJ_DETAIL="kept: not this process's session"; exit 0; }
        ;;
esac

# Remove entire session directory (state + counters + offset)
SESSION_DIR="$AGENT_DIR/sessions/$SESSION_ID"
# Never through a link between the project and the session's directory (task 194, grave, measured:
# with `.agent/sessions` a link, the directory of that name in the link's target was removed).
if ! _pb_inside_project "$PROJECT_DIR" "$SESSION_DIR"; then
    echo "[playbook] $SESSION_DIR lies behind a link — not removed" >&2
    PB_HJ_DETAIL="kept: behind a link"
    exit 0
fi
# ...and removed from INSIDE `sessions`, by its relative name (impl panel r2, codex: a swap between the
# check and an `rm` by path redirected it). Never an empty or a path-like name: `./` would be them all.
case "$SESSION_ID" in ''|.|..|*/*) exit 0 ;; esac
PB_HJ_HAD=true; { [ -e "$SESSION_DIR" ] || [ -L "$SESSION_DIR" ]; } || PB_HJ_HAD=false
( cd "$AGENT_DIR/sessions" 2>/dev/null && _pb_cwd_is "$PROJECT_DIR" "$AGENT_DIR/sessions" || exit 0
  [ -L "./$SESSION_ID" ] && exit 0
  rm -rf -- "./$SESSION_ID" ) 2>/dev/null || true
# the line says what is there now, not what was tried (impl panel r1, grok: a link or a failed rm read "removed")
if [ "$PB_HJ_HAD" != true ]; then
    PB_HJ_DETAIL="no session directory"          # impl panel r2, opus
elif [ -e "$SESSION_DIR" ] || [ -L "$SESSION_DIR" ]; then
    PB_HJ_DETAIL="kept: not removed"
else
    PB_HJ_DETAIL="session directory removed"
fi

exit 0
