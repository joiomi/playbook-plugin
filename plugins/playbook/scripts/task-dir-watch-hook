#!/bin/bash
# task-dir-watch-hook — the task-folder watch (task 196, PLAN S14 T5b, B31 = #12)
#   PreToolUse, a shell call or a Write: hold a flagged session (exit 2), else snapshot the lane's tasks/
#   PreToolUse, an edit: hold a flagged session
#   PostToolUse / PostToolUseFailure, a shell call or a Write: flag a task folder the call made by hand
#
# The decisions are scripts/task-dir-watch.py's (with tasks.registry, on the parsed payload); this script finds the
# project, the session's lane and its directory, and calls python only when there is something to decide: a flag
# standing, or — for a shell call or a Write — a lane that has `tasks/`, a registry or not (task 197). The event and the tool
# are read here only to skip python for an edit with no flag (an edit makes no folder); hooks.json passes no argument
# (the dual-host form, `tasks/hooks_check.py`), and a payload this read misjudges reaches python, which decides.
# No `set -e`: a failure here leaves no snapshot (the post then flags every unknown folder present) — and a crash
# while a flag stands holds the call (fail closed).

if [ "${PLAYBOOK_ROLE:-}" = "monitor" ]; then
    cat > /dev/null
    exit 0
fi

HOOK_DIR="$(cd "$(dirname "$0")" && pwd)"
source "$HOOK_DIR/gate-echo-lib.sh"

PROJECT_DIR=$(find_project_root)
if [ -z "$PROJECT_DIR" ]; then
    cat > /dev/null
    exit 0
fi
# The fresh-clone shape (lanes, no marker): whose lane this is cannot be told — the gate's rule too.
if [ -n "$(lanes_without_marker "$PROJECT_DIR")" ]; then
    cat > /dev/null
    exit 0
fi
# A malformed marker makes resolve_agent_dir exit: the task gate refuses edits then; nothing to watch here.
AGENT_DIR=$( (resolve_agent_dir "$PROJECT_DIR") 2>/dev/null ) || AGENT_DIR=""
if [ -z "$AGENT_DIR" ] || [ ! -d "$AGENT_DIR" ]; then
    cat > /dev/null
    exit 0
fi

INPUT=$(cat)

PB_WALK_READ="$(resolve_session_id trace)"
SESSION_ID="${PB_WALK_READ%%$'\t'*}"
# No session (the background daemon): nothing to watch or hold (a bound, task 196 W5).
[ -n "$SESSION_ID" ] || exit 0
SESSION_DIR="$AGENT_DIR/sessions/$SESSION_ID"
FLAG="$SESSION_DIR/task_dir_flag"

PB_FLAGGED=false
# a flag, or a pending entry a post wrote when it could not have the flag's lock (the single judge's K1) — the
# session path quoted, only the entry's suffix a glob (195's run 3, N2: `compgen -G` read `proj[one]` as a pattern)
{ [ -e "$FLAG" ] || [ -L "$FLAG" ]; } && PB_FLAGGED=true
for PB_PEND in "$FLAG".pending.*; do
    { [ -e "$PB_PEND" ] || [ -L "$PB_PEND" ]; } && PB_FLAGGED=true
    break
done
if [ "$PB_FLAGGED" != true ]; then
    # Claude's Edit/MultiEdit of an EXISTING file, with no flag: nothing to hold, nothing it could make — an empty
    # old_string creates the file and its folders (task 196 I12, measured), so that one goes on to python
    PB_KEY='"tool_name"[[:space:]]*:[[:space:]]*"(Edit|MultiEdit)"'
    PB_CREATES='"old_string"[[:space:]]*:[[:space:]]*""'
    if [[ "$INPUT" =~ $PB_KEY ]] && ! [[ "$INPUT" =~ $PB_CREATES ]]; then
        exit 0
    fi
    # every lane with `tasks/` is watched, a registry or not (task 197, P1)
    [ -d "$AGENT_DIR/tasks" ] || exit 0
fi
PB_POST='"(hook_event_name|hookEventName)"[[:space:]]*:[[:space:]]*"(PostToolUse[A-Za-z]*)"'
# A session directory that is a link (or `sessions` itself) is not this session's (task 194): not read, not written —
# and a session flagged before it became one stays held (193's run 3, M3: it was let through).
if ! _pb_session_dir_ok "$SESSION_DIR"; then
    if [ "$PB_FLAGGED" = true ] && ! [[ "$INPUT" =~ $PB_POST ]]; then
        cat >&2 <<MSG
BLOCKED: this session is held for a task folder the playbook CLI did not make, and its session directory
($SESSION_DIR) is now a link, so the hold cannot be checked. Put the real directory back in its place;
a person can also remove the folder named in its task_dir_flag and that file.
MSG
        exit 2
    fi
    exit 0
fi

PB_OUT=$(printf '%s' "$INPUT" | python3 -E -s "$HOOK_DIR/task-dir-watch.py" "$PROJECT_DIR" "$AGENT_DIR" \
         "$SESSION_DIR" "$SESSION_ID")
PB_RC=$?
[ -n "$PB_OUT" ] && printf '%s\n' "$PB_OUT"
case "$PB_RC" in
    0) exit 0 ;;
    2) exit 2 ;;
esac
# The watch did not run (no python3, a crash): a standing flag holds the call, as the gate holds on a status it
# cannot read (task 055); nothing stands — nothing to hold.
if [[ "$INPUT" =~ $PB_POST ]]; then
    # after a call: nothing to hold — said, so a folder this call made is known to wait for the close
    printf '{"hookSpecificOutput":{"hookEventName":"%s","additionalContext":"⚠ playbook: the task-folder watch could not run after this call (task-dir-watch.py ended with exit %s); a task folder made by hand is still refused at `tasks work done`."}}\n' \
        "${BASH_REMATCH[2]}" "$PB_RC"
    exit 0
fi
if [ "$PB_FLAGGED" = true ]; then
    cat >&2 <<MSG
BLOCKED: this session is held for a task folder the playbook CLI did not make, and the check that would
release it could not run (the watch's helper, task-dir-watch.py, ended with exit $PB_RC).
Restore a python3 of 3.10 or newer and the Playbook plugin; a person can also remove the folder named
in $FLAG and that file.
MSG
    exit 2
fi
exit 0
