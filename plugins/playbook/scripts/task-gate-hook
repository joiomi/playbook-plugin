#!/bin/bash
_PB_HJ_T0=$EPOCHREALTIME     # the hook journal's start (task 222): first, before anything else runs
# task-gate-hook
# PreToolUse hook — guards:
#   0. Write — block creating new task.md files (only tasks new CLI does that)
#   1. Edit/Write on code files blocked when no task is active (exit 2 = BLOCK)
#   2. Bash — the judge session's guard (Guard 3) and the session-id injection; a task folder made by hand is
#      caught AFTER the call by task-dir-watch-hook (task 197 removed the pre-run check)
#
# Allows: .agent/, .claude/ edits (task management, hook config)

set -e

# Skip when invoked from the monitor's own claude session (see launch-monitor).
# Log to stderr so the hook's firing is still visible; only gate-enforcement skipped.
if [ "${PLAYBOOK_ROLE:-}" = "monitor" ]; then
    echo "[$(basename "$0")] skip (PLAYBOOK_ROLE=monitor)" >&2
    exit 0
fi

# Source shared lib (same directory)
HOOK_DIR="$(cd "$(dirname "$0")" && pwd)"
source "$HOOK_DIR/gate-echo-lib.sh"
pb_hook_begin task-gate      # one line per run in journal/hooks.jsonl (task 222)

# is_code_file_path is defined in gate-echo-lib.sh (sourced above) so the codex
# parity test can source it in isolation — see tests/test_gate_classifier_parity.py.

# pb_journal_hop_refusal REASON — a refusal around a hop journals what it needs itself: it runs before this run
# resolves its session (impl round 1, opus: a run that hops left a session folder and a walk line in a project that
# judged nothing). With no project here (no AGENT_DIR) there is no journal to write.
pb_journal_hop_refusal() {
    local jd=""
    [ -n "${AGENT_DIR:-}" ] && [ -z "$(lanes_without_marker "$PROJECT_DIR")" ] && jd="$AGENT_DIR"
    journal_enforcement "$jd" task-gate block "$1" "$(resolve_session_id)" "${TOOL_NAME:-}" "${NORM_PATH:-}"
}

# pb_hop_to DIR — task 302 (audit 3 G1): judge this call where its target's owner is, by running this hook once
# more with DIR as its working directory, on the payload as the host sent it. `exec` keeps the process (the session
# walk reads the same chain) and runs no EXIT trap, so only the run that judges writes its journal line. Two hops at
# most — from no project to the target's project, then to the tree that owns the record (impl round 2: codex, grok,
# reproduced: the first hop used the only one and the second owner was never asked); a third is refused, never
# judged in the wrong tree. The session's activity folder (its counters) is carried across (PB_GATE_ACTIVITY_DIR), as
# the stop hook carries it. A DIR that cannot be entered is not hopped to: the call is judged here.
pb_hop_to() {
    local hops="${PB_GATE_HOPPED:-0}"
    case "$hops" in ''|*[!0-9]*) hops=2 ;; esac
    if [ "$hops" -ge 2 ]; then
        pb_journal_hop_refusal "a hop past the second"
        cat >&2 <<MSG
BLOCKED: judging this call needs a third tree (${1}) after two hops, so no tree's guards can judge it here.
Edit the file by its own path, from inside the tree that holds it.
MSG
        PB_HJ_DETAIL="a hop past the second"
        exit 2
    fi
    if [ -z "${PB_GATE_ACTIVITY_DIR:-}" ] && [ -n "${AGENT_DIR:-}" ]; then
        local sid
        sid=$(resolve_session_id) || sid=""
        [ -n "$sid" ] && export PB_GATE_ACTIVITY_DIR="$AGENT_DIR/sessions/$sid"
    fi
    cd -- "$1" 2>/dev/null || return 0
    export PB_GATE_HOPPED=$((hops + 1))
    exec "${BASH:-bash}" "$HOOK_DIR/task-gate-hook" < <(printf '%s' "$PB_RAW_INPUT")
}

# Find project root
PROJECT_DIR=$(find_project_root)
if [ -z "$PROJECT_DIR" ]; then
    # No project here (a session started in a parent folder): an Edit, Write, MultiEdit or NotebookEdit's absolute
    # target is judged in its own project, code edits included (task 302); a target in no project passes, as before.
    # In bash: this hook runs at every tool call of every folder (a user-scope install; task 194's lesson). The tool
    # and the path are read from the payload's own text; python3 reads the path only when that text holds an escape
    # (a `\"`, a `\\` or a `\u`), which the bash pattern cannot read. The owner is looked for from the path as
    # written, then from its resolved form (a link outside any project to a project's file; impl round 1, codex).
    PB_RAW_INPUT=$(cat)
    if [[ $PB_RAW_INPUT =~ \"tool_name\"[[:space:]]*:[[:space:]]*\"(Edit|Write|MultiEdit|NotebookEdit)\" ]]; then
        # the tool's own key, as the normaliser reads it (NotebookEdit: `notebook_path` alone; impl round 2, grok)
        _pb_key=file_path
        [ "${BASH_REMATCH[1]}" = NotebookEdit ] && _pb_key=notebook_path
        _pb_t=""
        if [[ $PB_RAW_INPUT =~ \"$_pb_key\"[[:space:]]*:[[:space:]]*\"((/|~/)[^\"\\]*)\" ]]; then
            _pb_t="${BASH_REMATCH[1]}"
        elif [[ $PB_RAW_INPUT =~ \"$_pb_key\"[[:space:]]*:[[:space:]]*\"[^\"]*\\ ]]; then
            _pb_t=$(printf '%s' "$PB_RAW_INPUT" | python3 -I -c 'import json, sys
ti = json.load(sys.stdin).get("tool_input") or {}
v = ti.get(sys.argv[1]) if isinstance(ti, dict) else ""
sys.stdout.write(v if isinstance(v, str) else "")' "$_pb_key" 2>/dev/null) || _pb_t=""
        fi
        # a leading `~/` is the user's home, as Guard 0.6 and the hop read it (impl round 2: agy, grok — reproduced)
        case "$_pb_t" in "~/"*) _pb_t="$HOME/${_pb_t#"~/"}" ;; esac
        case "$_pb_t" in /*)
            _pb_p=$(project_root_from "${_pb_t%/*}")
            if [ -z "$_pb_p" ] && _pb_real=$(realpath -m -- "$_pb_t" 2>/dev/null); then
                _pb_p=$(project_root_from "${_pb_real%/*}")
            fi
            [ -n "$_pb_p" ] && pb_hop_to "$_pb_p" ;;
        esac
    fi
    exit 0
fi

# The Python floor (task 194, PLAN S14 T5, #46), with this hook's polarity: it fails
# closed. Below 3.10 it says so, reads the payload with the stdlib one-liners as before,
# and lets no call through but a shell command (Guard F below). The launchers' one-line
# probe; no python3 lands here too (the payload is then unreadable: refused, as before).
# Asked only inside a project (impl panel r1, opus: before the project check every tool
# call of every project started python3).
PB_PY_FLOOR=true
if ! python3 -I -c 'import sys; sys.exit(0 if sys.version_info >= (3,10) else 1)' 2>/dev/null; then
    PB_PY_FLOOR=false
    PB_PY_FOUND="$(python3 --version 2>/dev/null | head -1 | tr -cd 'A-Za-z0-9._ -')"
    echo "playbook: needs python3 >= 3.10 (found: ${PB_PY_FOUND:-no python3 on PATH}) — the task gate lets no file edit through without it; upgrade python3" >&2
fi

# Self-heal any 0-byte wrapper before the tool (esp. a Bash `tasks …` call) runs,
# so a launcher a pre-fix kill left empty repairs itself on the very invocation
# that needs it — not one tool call later. `|| true` so it can't trip `set -e`
# or abort in a read-only sandbox.
heal_empty_wrappers "$PROJECT_DIR" || true

# I1: a malformed .agent/current_user makes resolve_agent_dir `exit 1`. At top
# level under `set -e` that aborted the whole hook with exit 1 — which Claude
# Code treats as a NON-blocking error, so the code edit proceeded (the enforcing
# gate failed OPEN). Detect the failure and FAIL CLOSED below (block code edits)
# instead of aborting-open, while still allowing .agent/.claude edits so the
# marker stays fixable. Never falls back to shared-root state for authorization.
if ! AGENT_DIR=$(resolve_agent_dir "$PROJECT_DIR" 2>/dev/null); then
    MARKER_INVALID=true
    AGENT_DIR="$PROJECT_DIR/.agent"   # nominal for path building; guards fail closed
else
    MARKER_INVALID=false
fi

# State file lives in per-session subdirectory; "default" used when no session_id
SESSION_DIR="$AGENT_DIR/sessions/default"
STATE_FILE="$SESSION_DIR/current_state"
CLAUDE_MD="$PROJECT_DIR/CLAUDE.md"

# CLAUDE.md keyword check — warn if task system exists but CLAUDE.md doesn't mention it
if [ -d "$AGENT_DIR/tasks" ] && [ -f "$CLAUDE_MD" ]; then
    if ! grep -qE 'tasks bootstrap|tasks work' "$CLAUDE_MD" 2>/dev/null; then
        cat >&2 <<'MSG'
WARNING: CLAUDE.md doesn't mention the task system. Essential commands:
  .claude/bin/tasks bootstrap          — load context
  .claude/bin/tasks work <N>           — activate task
  .claude/bin/tasks work done          — deactivate
  .claude/bin/tasks new <type> <name>  — create task
  .claude/bin/tasks list               — see all tasks
MSG
    fi
fi

# Read stdin (PreToolUse JSON)
INPUT=$(cat)
# The payload as the host sent it: the session-id injection answers with the
# call's own tool input (task 118), never the normalized copy built below.
PB_RAW_INPUT="$INPUT"

# Task 118 (gauntlet 2 G2-04, G2-28): answer a tasks-CLI call with its OWN tool
# input, only `command` prefixed with the session id. A host replaces the tool
# input with updatedInput: `{"command": …}` alone made grok deny every such call
# (its schema needs `description`) and Claude drop the call's description,
# timeout and run_in_background. Built from the raw payload (grok's `toolInput`;
# the normalized copy carries added alias keys the tool never sent); the id goes
# as argv and the payload on stdin, so nothing is pasted into Python source. If
# it cannot be built: a plain allow with no updatedInput, never a broken object.
# Task 301 (audit 3 G5): the builder also judges the raw command it prefixes. It exits 0 for a plain call of THIS
# project's CLI and 10 for any other: one line; `.claude/bin/tasks` with the hook's cwd and the payload's `cwd` at the
# project root, or `<project>/.claude/bin/tasks` when the project path holds no white space and none of
# `* ? [ ] ' " ~ # !` (bash would split or expand it); an injected subcommand as a whole word; none of
# `; & | < > $ ` ( ) { } \` or NUL anywhere, quoted or not; and the file is the plugin's managed wrapper by
# `create_wrapper`'s own rule (a regular file, no link on its path, its second line `# playbook-managed`; a custom
# launcher is the project's, not the plugin's). Impl round 1: codex, opus, sonnet, grok.
emit_session_injection() {
    local updated="" rc=0
    # below the floor the CLI refuses to run: nothing to inject, a plain allow (task 194)
    [ "$PB_PY_FLOOR" = true ] || { PB_HJ_DETAIL="session id not injected (python < 3.10)"; exit 0; }
    updated=$(printf '%s' "$PB_RAW_INPUT" | python3 -I -c '
import json, os, stat, sys
d = json.loads(sys.stdin.buffer.read().decode("utf-8"))
ti = d.get("tool_input")
if not isinstance(ti, dict):
    ti = d.get("toolInput")
if not isinstance(ti, dict) or not isinstance(ti.get("command"), str):
    sys.exit(1)
cmd, project, cwd = ti["command"], sys.argv[2], sys.argv[3]
pcwd = d.get("cwd")


def at_root():
    try:
        return os.path.samefile(cwd, project) and (not isinstance(pcwd, str) or os.path.samefile(pcwd, project))
    except (OSError, ValueError):
        return False


def managed_wrapper():
    w = os.path.join(project, ".claude", "bin", "tasks")
    try:
        if not stat.S_ISREG(os.lstat(w).st_mode):
            return False
        if os.path.realpath(w) != os.path.join(os.path.realpath(project), ".claude", "bin", "tasks"):
            return False
        with open(w, "rb") as fh:
            lines = fh.read(4096).split(b"\n")
        return len(lines) > 1 and lines[1].startswith(b"# playbook-managed")
    except (OSError, ValueError):
        return False


def plain(c):
    if any(ch in c for ch in "\n\r;&|<>$`(){}\\\0"):
        return False
    c = c.rstrip(" \t")
    literal = not any(ch.isspace() or ch in "*?[]\x27\"~#!" for ch in project)
    for head in ((project + "/.claude/bin/tasks ") if literal else None, ".claude/bin/tasks "):
        if head and c.startswith(head) and (head != ".claude/bin/tasks " or at_root()):
            return (c[len(head):].split(" ", 1)[0] in ("work", "status", "bootstrap", "freehand", "retro", "new")
                    and managed_wrapper())
    return False


ti = dict(ti)
ti["command"] = "export PLAYBOOK_SESSION_ID=" + sys.argv[1] + "; " + cmd
sys.stdout.write(json.dumps(ti))
sys.exit(0 if plain(cmd) else 10)
' "$SESSION_ID" "$PROJECT_DIR" "$PWD" 2>/dev/null) || rc=$?
    [ "$rc" = 0 ] || [ "$rc" = 10 ] || updated=""
    if [ -n "$updated" ] && [ "$rc" = 0 ]; then
        printf '{"hookSpecificOutput":{"hookEventName":"PreToolUse","permissionDecision":"allow","updatedInput":%s}}\n' "$updated"
        PB_HJ_DETAIL="session id injected"
    elif [ -n "$updated" ]; then
        # any other command: the prefix and NO decision, so the host's own permission check decides (Claude Code
        # applies an updatedInput that carries no decision, and checks the input the hook returns)
        printf '{"hookSpecificOutput":{"hookEventName":"PreToolUse","updatedInput":%s}}\n' "$updated"
        PB_HJ_DETAIL="session id injected, not approved"
    else
        PB_HJ_DETAIL="session id injection failed"
    fi
    exit 0
}

block_unreadable_payload() {
    cat >&2 <<'MSG'
BLOCKED: The enforcing task gate could not read a complete tool payload.

No authorization decision can be made from missing or malformed fields.
Retry the tool call after restoring python3/the Playbook hook scripts.
MSG
    PB_HJ_DETAIL="payload unreadable"
    exit 2
}

# Normalize provider payload dialects (grok camelCase + renamed tools →
# claude snake_case; identity for claude payloads). An enforcing read retries
# independent extraction after a fused failure and blocks if the payload stays
# unreadable. See scripts/hook-payload-normalize.py (task 014).
# --emit-fields does the normalize AND every field this hook needs in that same
# one process: tool_name, the tool-specific path, its lexical
# normpath, and the command. Before, each was its own `python3 -c` — four
# interpreter starts per tool call parsing the same JSON three times. Records
# are NUL-delimited because a command or path may contain newlines. The sentinel
# distinguishes "the fused read ran" from "python is missing / the script died";
# without it we fall through to the original per-field extraction below, because
# an ENFORCING gate must never mistake an unreadable payload for an empty one.
PB_FUSED=""
PB_SENTINEL=""
PB_PAYLOAD=""
TOOL_NAME=""
FILE_PATH=""
NORM_PATH=""
REAL_PATH=""
PB_CMD=""
PB_TRANSCRIPT=""
PB_FRAME_COMPLETE=true
{
    IFS= read -r -d '' PB_SENTINEL   || PB_FRAME_COMPLETE=false
    IFS= read -r -d '' TOOL_NAME     || PB_FRAME_COMPLETE=false
    IFS= read -r -d '' FILE_PATH     || PB_FRAME_COMPLETE=false
    IFS= read -r -d '' NORM_PATH     || PB_FRAME_COMPLETE=false
    IFS= read -r -d '' PB_CMD        || PB_FRAME_COMPLETE=false
    IFS= read -r -d '' PB_TRANSCRIPT || PB_FRAME_COMPLETE=false
    IFS= read -r -d '' PB_PAYLOAD    || PB_FRAME_COMPLETE=false
    IFS= read -r -d '' REAL_PATH     || PB_FRAME_COMPLETE=false
    # v4 (task 222): the hook journal's event, tool-call id, subagent id, host session id
    IFS= read -r -d '' PB_HJ_EVENT        || PB_FRAME_COMPLETE=false
    IFS= read -r -d '' PB_HJ_TOOL_USE_ID  || PB_FRAME_COMPLETE=false
    IFS= read -r -d '' PB_HJ_AGENT_ID     || PB_FRAME_COMPLETE=false
    IFS= read -r -d '' PB_HJ_HOST_SESSION || PB_FRAME_COMPLETE=false
} < <(printf '%s' "$INPUT" | python3 -E -s "$HOOK_DIR/hook-payload-normalize.py" --emit-fields 2>/dev/null) || true

if [ "$PB_SENTINEL" = "pb-fields-v4" ] && [ "$PB_FRAME_COMPLETE" = true ]; then
    PB_FUSED=1
    PB_HJ_FRAME=1      # the hook journal takes the frame's four as they are (task 222)
    INPUT="$PB_PAYLOAD"
else
    PB_HJ_EVENT=""; PB_HJ_TOOL_USE_ID=""; PB_HJ_AGENT_ID=""; PB_HJ_HOST_SESSION=""     # the journal reads $INPUT
    # Recovery path: normalize, then extract every field independently.  A
    # producer that emitted only a sentinel/partial frame must never turn an
    # Edit into empty truth.  Any decode/extraction failure blocks: this is the
    # enforcing hook, and unreadable input cannot authorize work.
    # dialects (grok camelCase + renamed tools → claude snake_case; identity for
    # claude payloads), then read the fields the guards below need up front.
    TOOL_NAME=""; FILE_PATH=""; NORM_PATH=""; REAL_PATH=""; PB_CMD=""
    NORMALIZED=""
    if NORMALIZED=$(printf '%s' "$INPUT" | python3 -E -s "$HOOK_DIR/hook-payload-normalize.py" 2>/dev/null) \
       && [ -n "$NORMALIZED" ]; then
        INPUT="$NORMALIZED"
    fi
    if ! TOOL_NAME=$(printf '%s' "$INPUT" | python3 -I -c \
        "import sys,json; d=json.load(sys.stdin); v=d.get('tool_name',''); sys.stdout.write(v if isinstance(v,str) else '')" \
        2>/dev/null); then
        block_unreadable_payload
    fi
    if ! FILE_PATH=$(printf '%s' "$INPUT" | python3 -I -c \
        "import sys,json; d=json.load(sys.stdin); ti=d.get('tool_input',{}); ti=ti if isinstance(ti,dict) else {}; t=d.get('tool_name',''); v=ti.get('notebook_path','') if t == 'NotebookEdit' else ti.get('file_path',''); sys.stdout.write(v if isinstance(v,str) else '')" \
        2>/dev/null); then
        block_unreadable_payload
    fi
    if ! NORM_PATH=$(FP="$FILE_PATH" python3 -I -c \
        "import os,sys; sys.stdout.write(os.path.normpath(os.environ['FP']))" \
        2>/dev/null); then
        block_unreadable_payload
    fi
    # the resolved path, as the fused frame gives it (task 198, #26)
    if ! REAL_PATH=$(FP="$FILE_PATH" python3 -I -c \
        "import os,sys; p=os.environ['FP']; sys.stdout.write(os.path.realpath(p) if p else '')" \
        2>/dev/null); then
        block_unreadable_payload
    fi
    if ! PB_CMD=$(printf '%s' "$INPUT" | python3 -I -c \
        "import sys,json; d=json.load(sys.stdin); ti=d.get('tool_input',{}); ti=ti if isinstance(ti,dict) else {}; v=ti.get('command',''); sys.stdout.write(v if isinstance(v,str) else '')" \
        2>/dev/null); then
        block_unreadable_payload
    fi
    # Downstream branches may reuse the successfully recovered fields exactly
    # like fused fields; the value denotes "fields ready", not wire provenance.
    PB_FUSED=fallback
fi

# A valid hook call always names a tool.  Empty/whitespace/wrong-typed names are
# schema failures, not evidence that the call is harmless.
if [[ ! "$TOOL_NAME" =~ [^[:space:]] ]]; then
    block_unreadable_payload
fi
case "$TOOL_NAME" in
    Edit|Write|MultiEdit|NotebookEdit)
        [[ "$FILE_PATH" =~ [^[:space:]] ]] || block_unreadable_payload
        ;;
    Bash)
        [[ "$PB_CMD" =~ [^[:space:]] ]] || block_unreadable_payload
        ;;
esac

# --- Task 302 (audit 3 G1): a task record is judged by the tree that owns it. The record guards below read only this
# project's lanes, so the main tree's task.md seen from a Claude Code worktree (where EnterWorktree moves the cwd, and
# so the hooks), or a worktree's seen from the main tree, was an exempt `.agent/` path here. The trees of THIS
# repository are the main tree (the cwd's tree with its last `/.claude/worktrees/<name>` cut off) and its worktrees
# (`.claude/worktrees/<name>`, or `<group>/<name>` under a folder that is no tree). A reading of the path — resolved,
# normalised, as written, and the `~/` ones Guard 0.6 reads — that names `<lane>/<dir>/task.md` where `<lane>` IS a
# lane of one of those trees (`-ef`, links followed, as pb_in_lane_tasks reads this project's: a lane or `.agent`
# linked to a store too) is that tree's record. When every such reading is one lane and no lane of this project, the
# gate is run once more in a tree that holds it (pb_hop_to), on the payload as sent; a path written relative (Claude
# Code sends absolute ones) is refused rather than re-read from another directory. Readings that name records of two
# different lanes are refused: no single tree can judge them (impl round 1: codex, agy, opus, grok). A record of an
# unrelated project stays not this guard's (retro 107 R6, task 171: `tasks new` cannot make a task there). ---
pb_has_lane() {     # pb_has_lane DIR — DIR holds `.agent/tasks` or a `.agent/<lane>/tasks`
    local lt
    for lt in "$1/.agent/tasks" "$1"/.agent/*/tasks; do [ -d "$lt" ] && return 0; done
    return 1
}
pb_repository_trees() {     # one per line: the main tree, then each worktree that holds a lane
    local main g w
    main=$(pb_main_tree "$PROJECT_DIR")
    printf '%s\n' "$main"
    for g in "$main"/.claude/worktrees/*/; do
        g="${g%/}"
        [ -d "$g" ] || continue
        if pb_has_lane "$g"; then
            printf '%s\n' "$g"
        elif ! [ -e "$g/.agent" ]; then
            for w in "$g"/*/; do w="${w%/}"; [ -d "$w" ] && pb_has_lane "$w" && printf '%s\n' "$w"; done
        fi
    done
}
if [ "$TOOL_NAME" != "Bash" ]; then
    PB_RT=""; PB_RT_TEXT=""; PB_RT_REAL=""
    case "$FILE_PATH" in "~/"*)
        PB_RT="$HOME/${FILE_PATH#"~/"}"
        PB_RT_TEXT=$(realpath -m -s -- "$PB_RT" 2>/dev/null) || PB_RT_TEXT=""
        PB_RT_REAL=$(realpath -m -- "$PB_RT" 2>/dev/null) || PB_RT_REAL="" ;;
    esac
    PB_REC_LANES=(); PB_REC_TREES=()
    for _pb_r in "$REAL_PATH" "$NORM_PATH" "$FILE_PATH" "$PB_RT" "$PB_RT_TEXT" "$PB_RT_REAL"; do
        case "$_pb_r" in */task.md) ;; *) continue ;; esac
        _pb_d="${_pb_r%/task.md}"
        case "${_pb_d##*/}" in ''|.|..) continue ;; esac
        _pb_d="${_pb_d%/*}"
        [ -n "$_pb_d" ] && [ -d "$_pb_d" ] || continue
        while IFS= read -r _pb_t; do
            [ -n "$_pb_t" ] || continue
            for _pb_lt in "$_pb_t/.agent/tasks" "$_pb_t"/.agent/*/tasks; do
                if [ -d "$_pb_lt" ] && [ "$_pb_d" -ef "$_pb_lt" ]; then
                    PB_REC_LANES+=("$_pb_lt"); PB_REC_TREES+=("$_pb_t")
                fi
            done
        done < <(pb_repository_trees)
    done
    if [ "${#PB_REC_LANES[@]}" -gt 0 ]; then
        _pb_one=true; _pb_here=false; _pb_other=""
        for _pb_k in "${!PB_REC_LANES[@]}"; do
            [ "${PB_REC_LANES[$_pb_k]}" -ef "${PB_REC_LANES[0]}" ] || _pb_one=false
            if [ "${PB_REC_TREES[$_pb_k]}" -ef "$PROJECT_DIR" ]; then _pb_here=true
            elif [ -z "$_pb_other" ]; then _pb_other="${PB_REC_TREES[$_pb_k]}"; fi
        done
        if [ "$_pb_one" != true ]; then
            pb_journal_hop_refusal "record of two trees"
            cat >&2 <<MSG
BLOCKED: this path names task records of two different trees of this repository (its readings —
as written, normalised, resolved — lead to different lanes), so no single tree's guards can judge it.
Edit the record by its own path, inside the tree that holds it.
MSG
            PB_HJ_DETAIL="record of two trees"
            exit 2
        fi
        if [ "$_pb_here" != true ] && [ -n "$_pb_other" ]; then
            case "$FILE_PATH" in
                /*|"~/"*) pb_hop_to "$_pb_other" ;;
                *)  pb_journal_hop_refusal "relative path to another tree's record"
                    cat >&2 <<MSG
BLOCKED: a path written relative to this directory names a task record of another tree of this repository
(${_pb_other}). Name it by its absolute path, so that tree's guards judge it.
MSG
                    PB_HJ_DETAIL="relative path to another tree's record"
                    exit 2 ;;
            esac
        fi
    fi
fi

# Session ID: env var → ancestor-scan → pid-$PPID (see gate-echo-lib.sh::resolve_session_id)
# Task 192 (#48): the id and what the resolver's own walk read, from ONE call (a
# second walk would not show a transient failure of the first).
PB_WALK_READ="$(resolve_session_id trace)"
SESSION_ID="${PB_WALK_READ%%$'\t'*}"
PB_WALK_READ="${PB_WALK_READ#*$'\t'}"

SESSION_DIR="$AGENT_DIR/sessions/$SESSION_ID"
STATE_FILE="$SESSION_DIR/current_state"
# Task 105: unresolved (under the Claude Code background daemon, no
# PLAYBOOK_SESSION_ID) — there is no session to read or create. An empty
# STATE_FILE reads as "no active task" below (fail-closed for code edits), and
# no directory is made: `sessions/` + "" would be the sessions dir itself.
if [ -z "$SESSION_ID" ]; then
    session_unresolved_notice
    SESSION_DIR=""
    STATE_FILE=""
fi
# Fresh-clone shape: AGENT_DIR is the shared root and creating the session dir
# there mints a phantom lane. Skip the mkdir — STATE_FILE then simply doesn't
# exist, which the guards below already read as "no active task" (fail-closed,
# the correct answer when we cannot tell whose lane this is). Never exit here:
# a hook that aborts takes the whole session down.
PB_FRESH_CLONE_LANES="$(lanes_without_marker "$PROJECT_DIR")"
# (and never through a link at the session directory or at `sessions` — task 194, impl panel r1)
if [ -z "$PB_FRESH_CLONE_LANES" ] && [ -n "$SESSION_DIR" ] && _pb_session_dir_ok "$SESSION_DIR"; then
    # NEW-2: guard the mkdir — under `set -e` an unwritable/full (ENOSPC,
    # read-only, wrong-perms) sessions dir made this abort with exit 1, a
    # NON-blocking code, so the ENFORCING gate stopped enforcing globally
    # (code edits proceeded). Fail-safe: on failure STATE_FILE simply won't
    # exist, which the guards below already read as "no active task" (block).
    # Mirrors the guard the non-enforcing state-echo hook already had.
    mkdir -p "$SESSION_DIR" 2>/dev/null || true
fi

# Enforcement-journal target (log-only, best-effort). The resolved lane — but
# NEVER in the fresh-clone shape (lanes exist, no marker): writing a root
# journal there would mint phantom root-lane state (see S15). Empty disables
# journalling; journal_enforcement no-ops on an empty dir.
PB_JOURNAL_DIR=""
[ -z "$PB_FRESH_CLONE_LANES" ] && PB_JOURNAL_DIR="$AGENT_DIR"
# Task 192 (#48): what the session walk read, on an unresolved id (and on every
# call under PLAYBOOK_WALK_TRACE=1). Log-only; returns 0.
journal_session_walk "$PB_JOURNAL_DIR" task-gate "$SESSION_ID" "$TOOL_NAME" "$PB_WALK_READ"

# --- Guard F: below the Python floor (task 194, #46) — fail closed. What authorizes an
# edit runs on python3 (the active task's status, Guard 0's target, the batch check) and
# cannot be trusted below 3.10 (measured under a 3.9 that runs the stdlib: a README write
# and a gate tick in task.md went through), so no call but a shell command passes here —
# not even an exempt `.agent/` edit: below the floor the CLI refuses to run, and the fix
# is python3, not a file. A shell command keeps the judge's guard, which needs no python
# of ours. ---
if [ "$PB_PY_FLOOR" != true ] && [ "$TOOL_NAME" != "Bash" ]; then
    journal_enforcement "$PB_JOURNAL_DIR" task-gate block "python3 below 3.10" \
        "$SESSION_ID" "$TOOL_NAME" "$FILE_PATH"
    cat >&2 <<MSG
BLOCKED: playbook needs python3 >= 3.10 (found: ${PB_PY_FOUND:-no python3 on PATH}).

The checks that authorize a file edit run on python3, so below 3.10 the task gate
authorizes none (${TOOL_NAME}). Shell commands still run. Upgrade python3, then retry.
MSG
    PB_HJ_DETAIL="python < 3.10"
    exit 2
fi

# --- Eval mode: skip guards if pretool_guard=off (keep session injection in Guard 2) ---
if [ -n "$PLAYBOOK_EVAL_CONFIG" ] && [ -f "$PLAYBOOK_EVAL_CONFIG" ]; then
    EVAL_PRETOOL=$(python3 -I -c "import json; print(json.loads(open('$PLAYBOOK_EVAL_CONFIG').read()).get('pretool_guard','on'))" 2>/dev/null || echo "on")
    if [ "$EVAL_PRETOOL" = "off" ]; then
        # Skip all guards, jump straight to Guard 2 (Bash session injection)
        if [ "$TOOL_NAME" = "Bash" ]; then
            if [ -n "$PB_FUSED" ]; then CMD="$PB_CMD"; else
            CMD=$(echo "$INPUT" | python3 -I -c "import sys,json; print(json.load(sys.stdin).get('tool_input',{}).get('command',''))" 2>/dev/null || echo "")
            fi
            # a loose match only picks the calls to prefix; whether one is approved is the builder's alone (task 301)
            if echo "$CMD" | grep -qE 'tasks\s+(work|status|bootstrap|freehand|retro|new)' && [ -n "$SESSION_ID" ]; then
                emit_session_injection
            fi
        fi
        PB_HJ_DETAIL="eval mode: guards off"
        echo '{}'; exit 0
    fi
fi

# pb_task_md_path — the path Guards 0 and 0.5 judge as a task record, or "" when it names none: the RESOLVED path
# when it ends `.agent[/<lane>]/tasks/<dir>/task.md` (links followed — task 198, #26: a link to `.agent` with another
# name, a file link to a record, a task-directory link with another number passed the pattern on the text; the record
# and the active task's number are read from it — task 197's plan panel P9), else the normalised path when IT does
# (task 158).
pb_task_md_path() {
    local p
    for p in "$REAL_PATH" "${NORM_PATH:-$FILE_PATH}"; do
        if pb_is_task_md "$p"; then
            printf '%s' "$p"
            return 0
        fi
    done
    return 0
}
pb_is_task_md() {
    [ -n "$1" ] && printf '%s\n' "$1" | grep -qE '\.agent(/[^/]+)?/tasks/[^/]+/task\.md$'
}
# pb_in_lane_tasks PATH... — one of the PATHs (pass the written, the normalised and the resolved one) is
# `<d>/<dir>/task.md` whose `<d>` IS one of this project's lanes' `tasks/` (the same directory — `-ef`, links followed —
# whatever either is called: a lane or `.agent` linked to a store holds no `.agent` in its real path; task 198, impl
# panel r1 I2; every reading and every lane — impl panel r2 J1, J3).
pb_in_lane_tasks() {
    local p d lt
    for p in "$@"; do
        case "$p" in */task.md) ;; *) continue ;; esac
        d="${p%/task.md}"
        case "${d##*/}" in ''|.|..) continue ;; esac      # `<dir>` is a name, not a hop
        d="${d%/*}"
        [ -n "$d" ] || continue
        for lt in "$PROJECT_DIR/.agent/tasks" "$PROJECT_DIR"/.agent/*/tasks; do
            [ -d "$lt" ] && [ "$d" -ef "$lt" ] && return 0
        done
    done
    return 1
}
# pb_lane_creation PATH... — one reading that lies in one of this project's lanes' `tasks/` names no existing file:
# lane and existence judged on the SAME reading (the single judge after impl panel r2, codex, reproduced: "exists
# under some reading" let a decoy where the text collapses turn the kernel's creation in the lane into a rewrite).
# A dangling link is a creation (`-e` follows it).
pb_lane_creation() {
    local p
    for p in "$@"; do
        [ -n "$p" ] || continue
        pb_in_lane_tasks "$p" && [ ! -e "$p" ] && return 0
    done
    return 1
}
# pb_is_active_record PATH NUMBER — PATH is the same FILE as the active record (device and inode, links followed —
# a hard link, a link to the lane, a task-directory link whatever its number; task 198, impl panel r1 I1-I3): any
# `tasks/<NUMBER>-*/task.md` of the lane, links among those included.
pb_is_active_record() {
    local e
    case "$2" in ''|*[!0-9]*) return 1 ;; esac
    [ -n "$1" ] && [ -e "$1" ] || return 1
    for e in "$AGENT_DIR/tasks/$2"-*/task.md; do
        [ -e "$e" ] && [ "$1" -ef "$e" ] && return 0
    done
    return 1
}

# --- Guard 0: Write — block creating new task.md files (only tasks new CLI does that) ---
if [ "$TOOL_NAME" = "Write" ]; then
    if [ -z "$PB_FUSED" ]; then
        FILE_PATH=$(echo "$INPUT" | python3 -I -c "import sys,json; d=json.load(sys.stdin); print(d.get('tool_input',{}).get('file_path',''))" 2>/dev/null || echo "")
    fi

    # Check if it's a task.md in .agent/tasks/ that doesn't exist yet. Judged on
    # the NORMALISED path, like Guard 1 (task 158): `…/N-x/./task.md`, a doubled
    # slash or an `x/..` hop name the same file, and the raw spelling matched no
    # pattern here while Guard 1 exempted it as an `.agent/` path.
    TASK_MD_PATH=$(pb_task_md_path)
    PB_IN_LANE=false
    pb_in_lane_tasks "$FILE_PATH" "$NORM_PATH" "$REAL_PATH" && PB_IN_LANE=true
    if [ -n "$TASK_MD_PATH" ] || [ "$PB_IN_LANE" = true ]; then
        # Task 171 (retro 107 R6): only a task record of THIS project is `tasks new`'s
        # to create — the pattern alone also refused a task.md of another project,
        # where this project's CLI creates nothing. `task-dir-target.py --creates`
        # answers the whole question — would this Write create a file inside the
        # project? — with the two inside helpers the task-directory guard uses
        # (lexical, physical). It gets the path AS WRITTEN (impl panel r1: `<link into
        # the project>/../.agent/…` collapses, as text, to a path outside it, and the
        # kernel follows the link first) and decides "exists already" for each reading
        # of it (impl panel r2: asked of the collapsed path alone, a decoy there made a
        # creation in this project pass as a rewrite). Exit 0 = creates nothing here;
        # 1 = it does, or may. Any other exit means the helper did not run (missing,
        # unreadable): the guard then decides as it did before it had a scope.
        if printf '%s' "$FILE_PATH" | PB_PROJECT="$PROJECT_DIR" python3 -E -s "$HOOK_DIR/task-dir-target.py" --creates 2>/dev/null; then
            PB_CREATES=0
        else
            PB_CREATES=$?
        fi
        # A record in the session lane's own `tasks/` (task 198, impl panel r1 I2) is this project's whatever
        # `--creates` reads: a lane linked to a store outside the project reads as outside.
        # A creation in a lane: a reading in the lane that names no existing file — the same reading for both
        # (pb_lane_creation); a dangling link is one too: the Write makes its target (impl panel r2 J2).
        if [ "$PB_CREATES" -eq 1 ] || { [ "$PB_IN_LANE" = true ] \
                && pb_lane_creation "$FILE_PATH" "$NORM_PATH" "$REAL_PATH"; } \
           || { [ "$PB_CREATES" -ne 0 ] && [ ! -f "${TASK_MD_PATH:-$FILE_PATH}" ]; }; then
            journal_enforcement "$PB_JOURNAL_DIR" task-gate block "manual task.md creation" \
                "$SESSION_ID" "$TOOL_NAME" "$FILE_PATH"
            cat >&2 <<'MSG'
BLOCKED: Only `.claude/bin/tasks new` creates task.md files.

Don't create task files manually. The CLI enforces templates and numbering.

Use:  .claude/bin/tasks new <type> <name>
Types: audit, bugfix, build, cleanup, eval, feature, light, ops, quick, refactor, research (run `tasks new` to see the current set)
MSG
            PB_HJ_DETAIL="task.md made by hand"
            exit 2
        fi
    fi
fi

# --- Guard 0.6: `## Status` is the CLI's (task 292, audit 1 G4 and item 4) ---
# An Edit that wrote `done` under `## Status` passed: every edit under `.agent/` is exempt below, and Guards 0 and 0.5
# look at a record's creation and its batch ticks only. For an Edit, Write or MultiEdit of an EXISTING task.md in one
# of this project's lanes — any task, not only the active one — `gate-batch-check.py --status` rebuilds the file the
# call leaves (as the Edit tool matches, task 291) and refuses another status as the CLI reads it, an added live
# `## Status`, or an edit it cannot place. `tasks work done` / `tasks blocked` write it and run no hook. A helper that
# does not run fails OPEN, loudly (the uniform policy).
if [ "$TOOL_NAME" = "Edit" ] || [ "$TOOL_NAME" = "Write" ] || [ "$TOOL_NAME" = "MultiEdit" ]; then
    # Every reading of the path that names an existing record in a lane is checked on its own (impl round 1, codex:
    # the kernel's reading can be a decoy outside while the tool writes the record the text names), the
    # home-relative one too (the tool expands a leading `~/`; measured: Read did).
    # Its readings are taken after the expansion (impl round 2, opus, codex: `~/jump/../proj/…` and `…/./task.md` named
    # no record as the lane test reads them): as the text reads it (`realpath -m -s`, the dot segments collapsed
    # without following a link) and resolved (`realpath -m`, as `REAL_PATH` reads a plain path: the links that exist
    # followed, a missing component skipped — the lane test reads the record's grandparent on the text of a path, so a
    # link to the task directory names the lane only resolved; post-panel runs 1 and 2, codex).
    PB_TILDE=""; PB_TILDE_TEXT=""; PB_TILDE_REAL=""
    case "$FILE_PATH" in "~/"*)
        PB_TILDE="$HOME/${FILE_PATH#"~/"}"
        PB_TILDE_TEXT=$(realpath -m -s -- "$PB_TILDE" 2>/dev/null) || PB_TILDE_TEXT=""
        PB_TILDE_REAL=$(realpath -m -- "$PB_TILDE" 2>/dev/null) || PB_TILDE_REAL="" ;;
    esac
    STATUS_HELPER="$HOOK_DIR/gate-batch-check.py"
    for PB_CAND in "$REAL_PATH" "${NORM_PATH:-$FILE_PATH}" "$FILE_PATH" "$PB_TILDE" "$PB_TILDE_TEXT" "$PB_TILDE_REAL"; do
        [ -n "$PB_CAND" ] && [ -f "$PB_CAND" ] && pb_in_lane_tasks "$PB_CAND" || continue
        if [ ! -r "$STATUS_HELPER" ]; then
            echo "[task-gate-hook] WARNING: helper not readable ($STATUS_HELPER)" \
                 "— the ## Status guard is DISABLED for this edit (failing open)." \
                 "Reinstall/repair the Playbook plugin." >&2
            break
        fi
        STATUS_RC=0
        STATUS_MSG=$(echo "$INPUT" | python3 -E -s "$STATUS_HELPER" --status \
            --tool "$TOOL_NAME" --file "$PB_CAND" --session-dir "$SESSION_DIR" 2>/dev/null) || STATUS_RC=$?
        if [ "$STATUS_RC" = "2" ]; then
            echo "$STATUS_MSG" >&2
            PB_HJ_DETAIL="status edit refused"
            exit 2
        elif [ "$STATUS_RC" != "0" ]; then
            echo "[task-gate-hook] WARNING: the ## Status guard did not run (exit $STATUS_RC)" \
                 "— failing open for this edit." >&2
        fi
    done
fi

# --- Guard 0.5: annotated batch-close (v2 — F1, blind-judge-reviewed) ---
# v1 blocked 3+ newly-checked gates per write and warned at 2 — the field's
# "checkbox tax" (6/6 journals). v2 moves the lever from "one gate per edit"
# to "every closed gate carries its own outcome evidence": batches of 2-5
# annotated closes are allowed, bare/sub-floor batches BLOCK (tightened from
# the old warn-at-2), 6+ blocks even annotated, born-checked lines block,
# and two batch closes with no tool call between them block the second.
# Logic lives in gate-batch-check.py (shared, testable); the helper fails
# OPEN on its own errors — only an explicit exit 2 blocks.
# Must run BEFORE the .agent/* early-exit in Guard 1.
# MultiEdit too (task 166): three gates ticked bare in one MultiEdit went through
# where the same ticks as one Edit were refused.
if [ "$TOOL_NAME" = "Edit" ] || [ "$TOOL_NAME" = "Write" ] || [ "$TOOL_NAME" = "MultiEdit" ]; then
    # Extract file_path (reuse from Guard 0 for Write, extract for Edit/MultiEdit)
    if [ -z "$FILE_PATH" ] && [ -z "$PB_FUSED" ]; then
        FILE_PATH=$(echo "$INPUT" | python3 -I -c "import sys,json; d=json.load(sys.stdin); print(d.get('tool_input',{}).get('file_path',''))" 2>/dev/null || echo "")
    fi

    # Check if this targets the active task's task.md — on the normalised path,
    # for the reason given at Guard 0 (task 158).
    TASK_MD_PATH=$(pb_task_md_path)
    PB_ACTIVE_BY_IDENTITY=false
    if [ -f "$STATE_FILE" ]; then
        ACTIVE_TASK=$(head -1 "$STATE_FILE" | tr -d '[:space:]')
        # The written file IS the active record (task 198, impl panel r1 — fable, opus, sonnet, codex): any link to it,
        # hard or symbolic, whatever the path spells. Identity is this project's record by itself.
        if pb_is_active_record "$FILE_PATH" "$ACTIVE_TASK"; then
            PB_ACTIVE_BY_IDENTITY=true
            [ -n "$TASK_MD_PATH" ] || TASK_MD_PATH="$FILE_PATH"
        fi
    fi
    if [ -f "$STATE_FILE" ] && { [ -n "$TASK_MD_PATH" ] || [ "$PB_ACTIVE_BY_IDENTITY" = true ]; }; then
        # … and it is THIS project's record (task 171, impl panel r2): another project's
        # `…/tasks/<the same number>-x/task.md` matched too, and a new one born with ticked
        # gates was refused here after Guard 0 had let it through. `--path` exits 0 only
        # for a path that is outside under every reading; a helper that does not run
        # leaves the guard on, as before.
        # The active task's record is the one whose OWN directory is `<number>-…` (the
        # single judge after round 2): `/<number>-` looked for anywhere in the path also
        # matched a project that lives in a directory called `001-project`, and then every
        # task record of it was judged by task 001's batch rule. The pattern above has
        # already made sure the path ends `…/tasks/<dir>/task.md`; this reads `<dir>`.
        # Either reading names it (task 198): the resolved path (a link to the record, a task-directory link with
        # another number — task 197's plan panel P9) or the normalised one (the active record's own directory may be
        # a link to a directory with another number).
        PB_IS_ACTIVE_RECORD=false
        for PB_CAND in "$REAL_PATH" "${NORM_PATH:-$FILE_PATH}"; do
            pb_is_task_md "$PB_CAND" || continue
            PB_TASK_DIR_NAME="${PB_CAND%/task.md}"
            PB_TASK_DIR_NAME="${PB_TASK_DIR_NAME##*/}"
            case "$PB_TASK_DIR_NAME" in
                "$ACTIVE_TASK"-*) PB_IS_ACTIVE_RECORD=true ;;
            esac
        done
        if [ -n "$ACTIVE_TASK" ] && { [ "$PB_ACTIVE_BY_IDENTITY" = true ] || { [ "$PB_IS_ACTIVE_RECORD" = true ] \
           && ! printf '%s' "$FILE_PATH" | PB_PROJECT="$PROJECT_DIR" python3 -E -s "$HOOK_DIR/task-dir-target.py" --path 2>/dev/null; }; }; then
            # "The guard could not run" => fail OPEN, loudly (uniform policy).
            # `python3 <missing-file>` exits 2, which is INDISTINGUISHABLE from
            # gate-batch-check's own legitimate block-with-exit-2 — so a missing
            # helper used to block the edit with an empty message, contradicting
            # the helper's documented "fails OPEN on its own errors" contract.
            # Decide by file existence BEFORE invoking (never guess from the exit
            # code): if the helper is absent/unreadable, warn on stderr and skip
            # the batch guard. When it IS present, its exit 2 is honoured exactly
            # as before — a genuine block is never suppressed.
            BATCH_HELPER="$HOOK_DIR/gate-batch-check.py"
            if [ ! -r "$BATCH_HELPER" ]; then
                echo "[task-gate-hook] WARNING: helper not readable ($BATCH_HELPER)" \
                     "— the annotated batch-close guard is DISABLED for this edit" \
                     "(failing open). Reinstall/repair the Playbook plugin." >&2
            else
                BATCH_RC=0
                BATCH_MSG=$(echo "$INPUT" | python3 -E -s "$BATCH_HELPER" \
                    --tool "$TOOL_NAME" --file "$TASK_MD_PATH" \
                    --session-dir "$SESSION_DIR" ${PB_GATE_ACTIVITY_DIR:+--activity-dir "$PB_GATE_ACTIVITY_DIR"} 2>/dev/null) || BATCH_RC=$?
                if [ "$BATCH_RC" = "2" ]; then
                    echo "$BATCH_MSG" >&2
                    PB_HJ_DETAIL="gate batch refused"
                    exit 2
                fi
            fi
        fi
    fi
fi

# --- Guard 1: Edit/Write/MultiEdit/NotebookEdit — require active task for code files ---
# I13: MultiEdit (file_path) and NotebookEdit (notebook_path) edit code too, but
# were omitted from the matcher AND this guard, so a no-task edit through them
# was never gated. `.ipynb` is now in is_code_file_path as well.
if [ "$TOOL_NAME" = "Edit" ] || [ "$TOOL_NAME" = "Write" ] \
   || [ "$TOOL_NAME" = "MultiEdit" ] || [ "$TOOL_NAME" = "NotebookEdit" ]; then
    # Reuse FILE_PATH from Guard 0/0.5 if already set; else read file_path OR
    # notebook_path (NotebookEdit uses the latter).
    if [ -z "$FILE_PATH" ] && [ -z "$PB_FUSED" ]; then
        FILE_PATH=$(echo "$INPUT" | python3 -I -c "import sys,json; d=json.load(sys.stdin).get('tool_input',{}); print(d.get('file_path','') or d.get('notebook_path',''))" 2>/dev/null || echo "")
    fi

    # NEW-1: resolve `..` BEFORE the .agent/.claude exemption. A path that merely
    # CONTAINS the token but traverses back out to a code file
    # (`.agent/../src/main.py`) must not be exempted — it used to be, while the
    # write landed on the real code file, bypassing the gate. Lexical normpath
    # only (no filesystem/symlink resolution → no TOCTOU); judge both the
    # exemption AND the code-file test on the resolved path.
    if [ -z "$PB_FUSED" ]; then
        NORM_PATH=$(FP="$FILE_PATH" python3 -I -c "import os; print(os.path.normpath(os.environ['FP']))" 2>/dev/null || echo "$FILE_PATH")
    fi

    # Allow .agent/ and .claude/ edits (task management, hook config). Task 298 (audit 2, G3): Claude Code makes its
    # worktrees in `.claude/worktrees/<name>/` — a checkout, not configuration — so what is inside one is judged as the
    # worktree's own path: only its own .agent/ and .claude/ are exempt (provider/policy.py strips the same segments).
    EXEMPT_PATH="$NORM_PATH"
    while :; do
        case "$EXEMPT_PATH" in
            */.claude/worktrees/*/*) EXEMPT_PATH="/${EXEMPT_PATH#*/.claude/worktrees/*/}" ;;
            */.claude/worktrees/*) EXEMPT_PATH="/" ;;
            *) break ;;
        esac
    done
    case "$EXEMPT_PATH" in
        */.agent/*|*/.claude/*) PB_HJ_DETAIL="exempt path (.agent/.claude)"; exit 0 ;;
    esac

    # Only block code files
    if ! is_code_file_path "$NORM_PATH"; then
        PB_HJ_DETAIL="not a code file"
        exit 0
    fi

    # Enforcement-journal (log-only) — the reason recorded at the final block
    # below; refined to a more specific string on the done-task arm.
    BLOCK_REASON="no active task"

    # I1: malformed marker — FAIL CLOSED. We cannot resolve which lane owns the
    # tasks, so no code edit is authorized (.agent/.claude edits were already
    # allowed above, so the marker stays fixable).
    if [ "${MARKER_INVALID:-false}" = true ]; then
        journal_enforcement "$PB_JOURNAL_DIR" task-gate block "marker invalid" \
            "$SESSION_ID" "$TOOL_NAME" "$NORM_PATH"
        cat >&2 <<'MSG'
BLOCKED: .agent/current_user is malformed — cannot resolve your lane.
Fix it to a single username line (letters, digits, and ._- only), e.g.:
  echo alice > .agent/current_user
Code edits are blocked until the lane resolves.
MSG
        PB_HJ_DETAIL="marker invalid"
        exit 2
    fi

    # Check for active task — the pointer must RESOLVE to a real task dir, not
    # merely be non-empty (I2). `.agent/**` is gate-exempt, so an agent could
    # `Write current_state=junk` and self-authorize; this also fires on a
    # stale/leftover pointer whose task dir was renamed or deleted. Same
    # NNN-*/task.md resolution the state-echo/stop hooks use.
    if [ -f "$STATE_FILE" ]; then
        TASK=$(head -1 "$STATE_FILE" | tr -d '[:space:]')
        # N2: the pointer fed a `find -path "*/${TASK}-*/*"` GLOB (until task 192),
        # so a bare glob metacharacter (`*`, `?`, `[…]`) in the gate-exempt
        # current_state matched a real task and self-authorized. Task pointers are
        # numeric — reject anything non-digit before it reaches the lookup.
        case "$TASK" in
            ''|*[!0-9]*) ;;   # empty or non-digit → not a valid pointer; fall through to block
            *)
                # Task 192 (#25): matched on the task directory's own name (gate-echo-lib.sh).
                RESOLVED=$(task_record_file "$AGENT_DIR" "$TASK")
                if [ -n "$RESOLVED" ]; then
                    # F3 (defense in depth): a pointer that resolves to a DONE
                    # task must not keep the gate open. Normal close clears the
                    # pointer, so this only fires on a stale/hand-written pointer
                    # to a closed task — `tasks work <N>` reopens it (status →
                    # in_progress) before any edit, so a real resume is unaffected.
                    # The status is read through scripts/task-status.py — the SAME
                    # fence-aware reader the CLI (core._extract_status) and the
                    # stop-hook use — so hook and CLI cannot disagree about which
                    # `## Status` is live (task 055). The awk it replaced was
                    # fence-blind LAST-wins and erred both ways: a fenced
                    # `## Status`/done example in the ACTIVE task blocked every
                    # edit; a fenced `## Status`/pending example after a live
                    # `done` let a STALE pointer authorize edits (043 round-4).
                    # Cost: one python spawn (~20-30 ms) per gated code edit.
                    # A reader CRASH (non-zero exit: tasks.core import-broken,
                    # unreadable file) is NOT "an active status": the payload
                    # guards above already block when python cannot read the
                    # payload, and the stop-hook fails closed on the same reader
                    # crash — so F3 blocks too (round-3 panel: authorizing here
                    # reopened the stale-done bypass whenever core was broken).
                    # A status the reader DID print (`pending`, `unknown`, …) that
                    # is not `done*` authorizes, as before.
                    if ! STATUS=$(python3 -E -s "$HOOK_DIR/task-status.py" "$RESOLVED" 2>/dev/null); then
                        journal_enforcement "$PB_JOURNAL_DIR" task-gate block "status unreadable" \
                            "$SESSION_ID" "$TOOL_NAME" "$NORM_PATH"
                        cat >&2 <<MSG
BLOCKED: could not read the active task's ## Status via python3 ($HOOK_DIR/task-status.py).

The task gate cannot tell whether task ${TASK} is still open, so no code edit is
authorized. Restore python3/the Playbook plugin (tasks.core must import), then retry.
MSG
                        PB_HJ_DETAIL="status unreadable"
                        exit 2
                    fi
                    STATUS=${STATUS%$'\r'}
                    # Match the CLI authority core._is_done (status STARTS WITH
                    # "done", so "done (2026-…)" counts). Empty/unparsable/unknown
                    # or any active status → authorize (never a new false block).
                    # S1a (task 080): a BLOCKED task is paused on the owner's
                    # decision — the CLI does not treat it as active
                    # (_find_active_task skips it), so neither does the gate.
                    # EXACT token, like core._is_blocked (`blockedness` is not it).
                    case "$STATUS" in
                        blocked)
                            journal_enforcement "$PB_JOURNAL_DIR" task-gate block "pointer to blocked task" \
                                "$SESSION_ID" "$TOOL_NAME" "$NORM_PATH"
                            cat >&2 <<MSG
BLOCKED: task ${TASK} is blocked — paused on a decision that is not the agent's.

Code edits wait until the task resumes. When the decision is made, resume with:
  .claude/bin/tasks work ${TASK}
MSG
                            PB_HJ_DETAIL="task ${TASK} blocked"
                            exit 2 ;;
                        done*) BLOCK_REASON="pointer to done task" ;;  # fall through to BLOCK
                        *)     # active (or unreadable) → authorize
                            journal_enforcement "$PB_JOURNAL_DIR" task-gate allow "active task" \
                                "$SESSION_ID" "$TOOL_NAME" "$NORM_PATH"
                            PB_HJ_DETAIL="active task ${TASK}"
                            exit 0 ;;
                    esac
                fi
                ;;
        esac
    fi

    # No active task — block code edit
    journal_enforcement "$PB_JOURNAL_DIR" task-gate block "$BLOCK_REASON" \
        "$SESSION_ID" "$TOOL_NAME" "$NORM_PATH"
    cat >&2 <<'MSG'
BLOCKED: No active task.

Code edits require an active task so work is tracked and directed.

Workflow:
  1. .claude/bin/tasks new <type> <name>   — create task
  2. .claude/bin/tasks work <N>            — activate immediately (don't wait)
  3. ... do the work gate by gate ...
  4. .claude/bin/tasks work done           — deactivate when finished

To resume an existing task:  .claude/bin/tasks work <N>
MSG
    PB_HJ_DETAIL="$BLOCK_REASON"
    exit 2
fi

# --- Guard 2: Bash — inject session_id (the manual task-dir check: task-dir-watch-hook, after the call) ---
if [ "$TOOL_NAME" = "Bash" ]; then
    if [ -n "$PB_FUSED" ]; then CMD="$PB_CMD"; else
    CMD=$(echo "$INPUT" | python3 -I -c "import sys,json; d=json.load(sys.stdin); print(d.get('tool_input',{}).get('command',''))" 2>/dev/null || echo "")
    fi

    # Guard 3: judge session — block task management commands. MUST run BEFORE
    # the injection early-exit below (I3): `tasks new`/`tasks work` also match
    # the injection pattern, so with the old order the injection allowed and
    # exited 0 first, and this block was dead code — a judge session could
    # create/activate tasks.
    if [ "$SESSION_ID" = "judge" ] && echo "$CMD" | grep -qE '(^|[;&|] *)(([^ ]*/)?)tasks (new|work)'; then
        cat >&2 <<'MSG'
BLOCKED: Judge session cannot create or activate tasks.

The judge reviews plans — it doesn't manage tasks.
MSG
        PB_HJ_DETAIL="judge session: tasks new/work"
        exit 2
    fi

    # The Bash pre-run task-dir check that stood here (tasks 080-110: a `mkdir` word, a `{` or a `$'` sent the
    # command to task-dir-target.py, which guessed from the TEXT whether it made a task folder) is gone with
    # task 197, by the owner's answer of 2026-10-13 12:27 ("O scot pentru shell"): a folder made by hand is
    # caught AFTER the call by task-dir-watch-hook, by any spelling (ledger PB-TASK-DIR-WATCH).

    # Inject PLAYBOOK_SESSION_ID into tasks CLI commands via updatedInput. The match is loose on purpose (a prefix
    # harms nothing); whether a call is APPROVED is the builder's alone (`emit_session_injection`, task 301).
    if [ -n "$SESSION_ID" ] && echo "$CMD" | grep -qE '(^|[;&|] *)(([^ ]*/)?)tasks (work|status|bootstrap|freehand|retro|new)'; then
        emit_session_injection
    fi
fi

# Everything else — allow
exit 0
