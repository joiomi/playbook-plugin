#!/bin/bash
# chat-log-hook
# Hook for logging all user messages with project context
#
# Triggered on UserPromptSubmit - logs to:
#   - <project>/.agent/chat_log.md (project-local only)
#
# Features:
#   - Message IDs (M001, M002, ...) for traceability
#   - Auto-migrates old format entries on first run
#   - Uses flock for atomic counter updates

set -e

# Skip when invoked from the monitor's own claude session (see launch-monitor).
# Log to stderr so the hook's firing is still visible; only gate-enforcement skipped.
if [ "${PLAYBOOK_ROLE:-}" = "monitor" ]; then
    echo "[$(basename "$0")] skip (PLAYBOOK_ROLE=monitor)" >&2
    exit 0
fi

# Source shared lib (same directory)
HOOK_DIR="$(cd "$(dirname "$0")" && pwd)"
source "$HOOK_DIR/gate-echo-lib.sh"

# Find project root
PROJECT_DIR=$(find_project_root)
if [ -z "$PROJECT_DIR" ]; then
    exit 0
fi

AGENT_DIR=$(resolve_agent_dir "$PROJECT_DIR")

# Skip logging if .agent/ isn't writable (sandbox mode, non-playbook project)
if ! agent_dir_writable "$PROJECT_DIR"; then
    exit 0
fi

LOCAL_LOG="$AGENT_DIR/chat_log.md"
COUNTER_FILE="$AGENT_DIR/chat_log_counter"

# Create agent directory if it doesn't exist
mkdir -p "$AGENT_DIR"

# Get next message ID (flock for atomicity where available, plain fallback otherwise)
get_next_id() {
    local counter_file="$1"
    # _safe_int on the file content: chat_log_counter lives under .agent/
    # (gate-exempt, untrusted), and `$(( n + 1 ))` executes command
    # substitution embedded in `n` (C5). Coerce before any arithmetic.
    if command -v flock &>/dev/null; then
        (
            flock -x 200
            local n=$(_safe_int "$(cat "$counter_file" 2>/dev/null)")
            echo $((n + 1)) > "$counter_file"
            printf "M%03d" $((n + 1))
        ) 200>"$counter_file.lock"
    else
        local n=$(_safe_int "$(cat "$counter_file" 2>/dev/null)")
        echo $((n + 1)) > "$counter_file"
        printf "M%03d" $((n + 1))
    fi
}

# Migrate old format entries to new format with IDs
# Old: **[2026-01-27 07:42:28 UTC]** `SANDBOX`
# New: **[M001]** [2026-01-27 07:42:28 UTC] `HOST`
migrate_if_needed() {
    local log_file="$1"
    local counter_file="$2"

    # Skip if log doesn't exist or is empty
    [ -f "$log_file" ] || return 0
    [ -s "$log_file" ] || return 0

    # Skip if already migrated (has [M###] format)
    if grep -q '^\*\*\[M[0-9]\{3\}\]' "$log_file" 2>/dev/null; then
        return 0
    fi

    # Skip if no old-format entries exist
    if ! grep -q '^\*\*\[[0-9]\{4\}-' "$log_file" 2>/dev/null; then
        return 0
    fi

    # Create temp file for migration
    local temp_file="$log_file.new"
    local backup_file="$log_file.bak"

    # Count entries in original (number of --- separators)
    local orig_count=$(grep -c '^---$' "$log_file" || echo 0)

    # Transform: add [MNNN] prefix to each entry
    local msg_num=0

    while IFS= read -r line || [ -n "$line" ]; do
        if [[ "$line" =~ ^\*\*\[[0-9]{4}-[0-9]{2}-[0-9]{2} ]]; then
            # Old format timestamp line - add message ID
            msg_num=$((msg_num + 1))
            local msg_id=$(printf "M%03d" $msg_num)
            # Transform **[timestamp]** to **[MXXX]** [timestamp]
            line=$(echo "$line" | sed "s/^\*\*\[\([^]]*\)\]\*\*/\*\*[$msg_id]\*\* [\1]/")
        fi
        echo "$line"
    done < "$log_file" > "$temp_file"

    # Validate: entry count should match
    local new_count=$(grep -c '^---$' "$temp_file" || echo 0)
    if [ "$orig_count" != "$new_count" ]; then
        rm -f "$temp_file"
        echo "Migration validation failed: entry count mismatch ($orig_count vs $new_count)" >&2
        return 1
    fi

    # Atomic swap with backup
    cp "$log_file" "$backup_file"
    mv "$temp_file" "$log_file"

    # Update counter
    echo "$msg_num" > "$counter_file"
}

# Get timestamp in ISO 8601 format
TIMESTAMP=$(date -u +"%Y-%m-%d %H:%M:%S UTC")

# Read input from stdin
INPUT=$(cat)

# Normalize provider payload dialects (grok wraps the prompt in
# <user_query> tags and uses camelCase keys; identity for claude payloads;
# fail-open on any error). See scripts/hook-payload-normalize.py (task 014).
HOOK_DIR="$(cd "$(dirname "$0")" && pwd)"
NORMALIZED=$(printf '%s' "$INPUT" | python3 -E -s "$HOOK_DIR/hook-payload-normalize.py" 2>/dev/null || true)
if [ -n "$NORMALIZED" ]; then
    INPUT="$NORMALIZED"
fi

# Try to extract prompt from JSON, fallback to raw input if not JSON
if command -v jq &> /dev/null; then
    # `|| true`: on malformed JSON jq exits non-zero (4 on a parse error) and,
    # under `set -e`, that status propagated out of the assignment and ABORTED
    # the hook before the raw-input fallback below could run — making the
    # fallback dead code (and, on a jq build that returns 2, a spurious
    # UserPromptSubmit block). Swallow jq's status so the `[ -z ]` fallback is
    # always reachable.
    USER_MESSAGE=$(echo "$INPUT" | jq -r '.prompt // empty' 2>/dev/null || true)
    if [ -z "$USER_MESSAGE" ]; then
        USER_MESSAGE="$INPUT"
    fi
else
    # No jq: parse with python3 (the normalizer above already needs it). The old
    # grep matched only compact `"prompt":"..."` JSON, so an ordinary spaced
    # payload fell back to the raw JSON and the harness filter below saw `{`
    # (task 088, panel r1). Bytes in and out as UTF-8 whatever the locale.
    USER_MESSAGE=$(printf '%s' "$INPUT" | python3 -I -c 'import json, sys
try:
    v = json.loads(sys.stdin.buffer.read().decode("utf-8")).get("prompt")
except Exception:
    v = None
if isinstance(v, str):
    sys.stdout.buffer.write(v.encode("utf-8"))' 2>/dev/null || true)
    if [ -z "$USER_MESSAGE" ]; then
        USER_MESSAGE="$INPUT"
    fi
fi

# PLAN S5a (task 088): a prompt that BEGINS with a harness marker is a harness
# event — a background-task notification, a slash-command echo — not the user's
# words; on 2026-09-23, 498 of 833 entries began with <task-notification>, and
# attribution / intent / retro read them as the user. Skipped (no consumer needs
# them). Only the START counts: a user prompt that merely mentions one is logged.
# The two older exits below (empty after filtering, same-second duplicate)
# predate task 088.
# Task 105: resolved ONCE here; "" = unresolved (under the Claude Code
# background daemon, no PLAYBOOK_SESSION_ID) — the prompt is still logged
# (tagged `no-session`), but no session counters are touched.
SESSION_ID="$(resolve_session_id)"
[ -z "$SESSION_ID" ] && session_unresolved_notice
# A user's prompt ends whatever a notification began (task 173): it begins a new
# prompt generation — FIRST, so that a mark published by a stop hook still in
# flight is already of an older one — and the stop hook's mark and the
# notification's baseline go. Every prompt of the user's does this, also the two
# the hook logs nothing for further down.
drop_notification_marks() {
    [ -n "$SESSION_ID" ] || return 0
    local dir="$AGENT_DIR/sessions/$SESSION_ID"
    [ -d "$dir" ] || return 0
    new_prompt_generation "$dir"
    rm -f "$dir/turn_end" "$dir/notif_start" 2>/dev/null || true
}
reset_session_counters() {
    [ -n "$SESSION_ID" ] || return 0
    local session_dir="$AGENT_DIR/sessions/$SESSION_ID"
    mkdir -p "$session_dir"
    reset_counters "$session_dir/counters"
    drop_notification_marks
}
# Owner's Q1 (2026-09-24; PLAN S11, task 173): an AUTOMATIC notification does not
# reset the counters the stop hook's bypass reads. It is not the user's prompt and
# it can land in the middle of a turn — measured live on 2026-10-10: a background
# command's notification took a turn's `tools=20 writes=20` to `0 0` between two
# of its tool calls, and a stop right after it would have been released with every
# gate open. The one exception he made: a turn STARTED by a notification may end
# if it made no write. A turn started by one is told from a turn one landed in by
# the stop hook's mark: the file `turn_end` holds the tool count at the last stop
# it let through — it equals `tools` only while no tool has run since — and a
# nonce made for that stop. Then, and only then, the write count of this moment
# is noted (file `notif_start`) WITH THAT NONCE, for the stop hook to compare.
# Otherwise nothing is written; no counters file, nothing is created.
# The counters file is READ ONCE and never written here (impl panel r1): a tool
# call's hook bumps `tools` and then `writes`, each by renaming a new file into
# place, so one read is one consistent picture — it cannot show the old `tools`
# beside the new `writes` — and nothing here can rename a stale copy over an
# increment.
# No lock, and no order to rely on (post-D6 run 1; round 2 had a lock with a time
# limit, and the limit was the hole): if a user's prompt removes the mark while
# this runs, the baseline written afterwards names a mark that is gone, and the
# stop hook honours a baseline only beside the mark with its nonce. The same for
# the other direction — a stop hook still running when the user's prompt arrives
# (run 2): its mark carries the prompt generation it started in, the prompt began
# a new one, and a mark of another generation is not taken for a start.
note_notification() {
    [ -n "$SESSION_ID" ] || return 0
    local dir="$AGENT_DIR/sessions/$SESSION_ID"
    [ -f "$dir/counters" ] || return 0
    local mark ended nonce snapshot tools writes
    mark=$(read_session_mark "$dir/turn_end")
    [ -n "$mark" ] || return 0
    ended="${mark%% *}"
    nonce="${mark#* }"
    # A mark of another prompt generation is not this turn's: the stop hook that
    # wrote it started before the user's last prompt (post-D6 run 2).
    [ "${nonce%%-*}" = "$(read_prompt_generation "$dir")" ] || return 0
    snapshot=$(cat "$dir/counters" 2>/dev/null) || return 0
    tools=$(printf '%s\n' "$snapshot" | sed -n 's/^tools=//p' | head -1)
    writes=$(printf '%s\n' "$snapshot" | sed -n 's/^writes=//p' | head -1)
    [ "$ended" = "$tools" ] || return 0
    case "$writes" in ''|*[!0-9]*) return 0 ;; esac
    [ "${#writes}" -le 18 ] || return 0
    write_session_mark "$dir/notif_start" "$writes $nonce"
}
_lead="${USER_MESSAGE#"${USER_MESSAGE%%[![:space:]]*}"}"
case "$_lead" in
    "<task-notification>"*|"[SYSTEM NOTIFICATION"*)
        note_notification
        exit 0 ;;
    "<local-command-caveat>"*|"<command-name>"*)
        # The echo of a command the USER ran (a slash command, a `!` command):
        # skipped from the log like a notification, but it is their act and
        # starts a fresh count, as any prompt of theirs does.
        reset_session_counters
        exit 0 ;;
esac

# Filter out IDE notification tags (noise from VSCode integration)
# Flatten multiline to single line first
USER_MESSAGE=$(echo "$USER_MESSAGE" | tr '\n' ' ' | sed 's/  */ /g')

# Filter IDE tags using non-greedy pattern [^<]* to avoid over-matching
USER_MESSAGE=$(echo "$USER_MESSAGE" | sed 's/<ide_opened_file>[^<]*<\/ide_opened_file>//g; s/<ide_selection>[^<]*<\/ide_selection>//g')

# Trim whitespace
USER_MESSAGE=$(echo "$USER_MESSAGE" | sed 's/^[[:space:]]*//; s/[[:space:]]*$//')

# Truncate only huge messages (a pasted log or dump). Task 127 (owner Q-C (b),
# 2026-09-29): the cap was 500 characters, which cut ordinary long instructions —
# the user's own words, which the log and task.md's Recent Chat exist to keep.
# Task 138 G2-2: counted and cut in CHARACTERS by python3 — bash's ${#v} / ${v:0:N}
# count bytes under LC_ALL=C (or any non-UTF-8 locale), which cut a message
# under the cap and could split a character. ${#v} is never below the character count,
# so it is only the cheap pre-check; bash's cut is the fallback when python3 fails.
MAX_LEN=50000
if [ ${#USER_MESSAGE} -gt $MAX_LEN ]; then
    _cut=$(printf '%s' "$USER_MESSAGE" | PB_MAX_LEN=$MAX_LEN python3 -I -c 'import os, sys
s = sys.stdin.buffer.read().decode("utf-8", "surrogateescape")
n = int(os.environ["PB_MAX_LEN"])
if len(s) > n:
    s = s[:n] + "...[%d chars removed]" % (len(s) - n)
sys.stdout.buffer.write(s.encode("utf-8", "surrogateescape"))' 2>/dev/null) && USER_MESSAGE="$_cut" || {
        REMOVED=$((${#USER_MESSAGE} - MAX_LEN))
        USER_MESSAGE="${USER_MESSAGE:0:$MAX_LEN}...[${REMOVED} chars removed]"
    }
fi

# Skip logging if message is empty after filtering. No count is reset for it (as
# before task 088) — but it is the user's prompt: what a notification began ends.
if [ -z "$USER_MESSAGE" ]; then
    drop_notification_marks
    exit 0
fi

# Initialize local chat log with header if it doesn't exist
if [ ! -f "$LOCAL_LOG" ]; then
    echo "# Project Chat Log" > "$LOCAL_LOG"
    echo "" >> "$LOCAL_LOG"
    echo "User messages logged with timestamps." >> "$LOCAL_LOG"
    echo "" >> "$LOCAL_LOG"
fi

# Migrate old format if needed (runs once, idempotent)
migrate_if_needed "$LOCAL_LOG" "$COUNTER_FILE"

# Dedup guard: skip if last entry has same timestamp and content
LAST_TS=$(tail -10 "$LOCAL_LOG" 2>/dev/null | grep -o '\[[0-9-]* [0-9:]* UTC\]' | tail -1)
LAST_MSG=$(tail -3 "$LOCAL_LOG" 2>/dev/null | grep -v '^$' | grep -v '^\*\*\[' | grep -v '^---' | tail -1)
if [ "[$TIMESTAMP]" = "$LAST_TS" ] && [ "$USER_MESSAGE" = "$LAST_MSG" ]; then
    drop_notification_marks     # the user's prompt all the same (task 173)
    exit 0
fi

# Get next message ID
MSG_ID=$(get_next_id "$COUNTER_FILE")

# Session ID (the PID tag in the chat log) — resolved above, before the
# harness-marker exit; `no-session` when unresolved (task 105).
LOG_SESSION_TAG="${SESSION_ID:-no-session}"
PROVIDER="${PLAYBOOK_PROVIDER:-claude}"

# Append to local chat log with message ID and PID tag.
#
# Task 058: hold the SAME lock the counter uses across the whole append, not
# just around the id allocation. `tasks tag` REWRITES this file (tag insertion),
# and an append that began while that rewrite was in flight was replaced away
# with it — the prompt was simply gone. With both sides on this lock the two
# protocols serialize; where `flock` is unavailable (no util-linux)
# the append is unchanged and `tasks tag` still refuses a stale rewrite rather
# than losing a message.
append_message() {
    echo "---" >> "$LOCAL_LOG"
    echo "" >> "$LOCAL_LOG"
    echo "**[$MSG_ID]** [$TIMESTAMP] \`HOST\` ($PROVIDER/$LOG_SESSION_TAG)" >> "$LOCAL_LOG"
    echo "" >> "$LOCAL_LOG"
    echo "$USER_MESSAGE" >> "$LOCAL_LOG"
    echo "" >> "$LOCAL_LOG"
}
if command -v flock &>/dev/null; then
    (
        flock -x 201
        append_message
    ) 201>"$COUNTER_FILE.lock"
else
    append_message
fi

# Reset tool/write counters for this session (new user prompt = fresh count)
reset_session_counters
