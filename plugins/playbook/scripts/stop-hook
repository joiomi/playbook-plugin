#!/bin/bash
_PB_HJ_T0=$EPOCHREALTIME     # the hook journal's start (task 222): first, before anything else runs
# stop-hook
# Stop hook — a memento, never a block (task 340, PLAN-PLAYBOOK-2.md 4.1 b; the owner's R14: "rămâne ca memento,
# doar blocarea pleacă (214 alarme false din 223)").
#
# Reads the active task's task.md and counts its open gates (- [ ]). When a working turn ends with gates open it
# prints Claude Code's `{"systemMessage": …}` naming the task, the count and the first open gate — shown to the
# person — and the stop ends. Every path exits 0. No memento for a chat reply (writes 0, tools < 5), a blocked task,
# a task with every gate checked, no active task or the Freehand gate.

set -e

# Skip when invoked from the monitor's own claude session — monitor runs in
# the same project dir and would otherwise remind about the FRONT agent's
# task gates. Launch-monitor exports PLAYBOOK_ROLE=monitor specifically.
if [ "${PLAYBOOK_ROLE:-}" = "monitor" ]; then
    echo "[stop-hook] skip (PLAYBOOK_ROLE=monitor)" >&2
    exit 0
fi

# The Python floor (task 193, PLAN S14 T4, #46): below 3.10 it says so and takes its python-free path — the gates
# counted by the fence-blind grep — so an open gate still gets its memento. The launchers' one-line probe; no python3
# lands here too.
PB_PY_FLOOR=true
if ! python3 -I -c 'import sys; sys.exit(0 if sys.version_info >= (3,10) else 1)' 2>/dev/null; then
    PB_PY_FLOOR=false
    PB_PY_FOUND="$(python3 --version 2>/dev/null | head -1 | tr -cd 'A-Za-z0-9._ -')"
    echo "playbook: needs python3 >= 3.10 (found: ${PB_PY_FOUND:-no python3 on PATH}) — the stop hook counts the gates without it; upgrade python3" >&2
fi

# Source shared lib (same directory)
HOOK_DIR="$(cd "$(dirname "$0")" && pwd)"
source "$HOOK_DIR/gate-echo-lib.sh"
pb_hook_begin stop           # one line per run in journal/hooks.jsonl (task 222)

# pb_memento TEXT DETAIL — the stop's answer when work is left (task 340): one JSON object on stdout, Claude Code's
# `systemMessage`, shown to the person; the stop ends (exit 0). `_json_str` escapes it, the control bytes left are
# dropped and the text is cut at 400 characters (counted in a UTF-8 locale where there is one), so the object stays
# one valid line whatever a gate's title holds.
pb_memento() {
    local s
    s=$(_json_str "$1")
    s="${s//[[:cntrl:]]/}"
    s=$(LC_ALL=C.UTF-8; printf '%s' "${s:0:400}")
    printf '{"systemMessage":"%s"}\n' "$s"
    PB_HJ_DECISION=allow; PB_HJ_DETAIL="memento: $2"
    exit 0
}

# Find project root
PROJECT_DIR=$(find_project_root)
if [ -z "$PROJECT_DIR" ]; then
    exit 0
fi

# I1: a malformed .agent/current_user makes resolve_agent_dir `exit 1`, which at
# top level under `set -e` aborted the hook with exit 1. Detect it: the memento
# says the lane's gates could not be checked.
if ! AGENT_DIR=$(resolve_agent_dir "$PROJECT_DIR" 2>/dev/null); then
    MARKER_INVALID=true
    AGENT_DIR="$PROJECT_DIR/.agent"   # nominal for path building
else
    MARKER_INVALID=false
fi

SESSION_ID="$(resolve_session_id)"
# A stop decided in the main tree for a worktree session (task 302) keeps reading the turn's counters in the
# worktree's session folder, where the session's hooks keep them: the main tree's are frozen at the moment the session
# left (impl round 1: opus, grok — reproduced — and codex).
PB_ACTIVITY_DIR="${PB_STOP_ACTIVITY_DIR:-$AGENT_DIR/sessions/$SESSION_ID}"

INPUT=$(cat)                 # the Stop payload: only the worktree hop below re-reads it

if [ "${MARKER_INVALID:-false}" = true ]; then
    pb_memento "playbook: .agent/current_user is malformed, so this lane's task gates could not be checked — fix it to a single username line (letters, digits and ._- only)." "marker invalid"
fi

# Task 105: unresolved (under the Claude Code background daemon, or an ancestor whose argv could not be read; no
# PLAYBOOK_SESSION_ID): the hook cannot see which task's gates are open, and says so.
if [ -z "$SESSION_ID" ]; then
    session_unresolved_notice
    pb_memento "playbook: this session could not be identified, so its task gates could not be checked." "no session"
fi

SESSION_DIR="$AGENT_DIR/sessions/$SESSION_ID"
STATE_FILE="$SESSION_DIR/current_state"

# Task 302 (audit 3 G1): a session in a Claude Code worktree (`<X>/.claude/worktrees/<name>/`, where EnterWorktree
# moves the cwd and so the hooks) with no pointer of its own there still answers for its task in the main tree X:
# the stop is decided once more, in X, on the same payload (`exec`: the same process, no EXIT trap, so only that run
# writes its journal line; PB_STOP_HOPPED stops a second hop). A pointer in the worktree decides there (task 298: one
# session, one task).
pb_stop_in_main_tree() {
    [ -z "${PB_STOP_HOPPED:-}" ] || return 0
    case "$PROJECT_DIR" in */.claude/worktrees/*) ;; *) return 0 ;; esac
    local main root
    main=$(pb_main_tree "$PROJECT_DIR")
    [ "$main" != "$PROJECT_DIR" ] || return 0
    root=$(project_root_from "$main")
    [ -n "$root" ] && [ "$root" -ef "$main" ] || return 0
    case "$PB_ACTIVITY_DIR" in /*) ;; *) PB_ACTIVITY_DIR="$PWD/$PB_ACTIVITY_DIR" ;; esac
    cd -- "$main" 2>/dev/null || return 0
    export PB_STOP_HOPPED=1 PB_STOP_ACTIVITY_DIR="$PB_ACTIVITY_DIR"
    exec "${BASH:-bash}" "$HOOK_DIR/stop-hook" < <(printf '%s' "$INPUT")
}

# No active task — allow
if [ ! -f "$STATE_FILE" ]; then
    pb_stop_in_main_tree
    PB_HJ_DECISION=allow; PB_HJ_DETAIL="released: no active task"
    exit 0
fi

TASK=$(head -1 "$STATE_FILE" | tr -d '[:space:]')
# N2: task pointers are numeric — a non-digit value (incl. a glob metachar, which
# matched a real task under the `find -path` this hook used before task 192) is not
# a valid pointer. Blank it so it reads as "no active task".
case "$TASK" in *[!0-9]*) TASK="" ;; esac
if [ -z "$TASK" ]; then
    pb_stop_in_main_tree
    PB_HJ_DECISION=allow; PB_HJ_DETAIL="released: no active task"
    exit 0
fi
PB_HJ_TASK="$TASK"      # the journal line names the task this hook decided on (task 234)

# Find task file
TASK_FILE=$(task_record_file "$AGENT_DIR" "$TASK")

# Unresolvable pointer (task file not found — a stale/hand-written pointer to a
# deleted or renamed task dir) => ALLOW the stop. There are no gates to enforce,
# so there is nothing to hold the turn open on. This DELIBERATELY differs from
# task-gate-hook, which BLOCKS an unresolvable pointer: that hook answers a
# different question — "may this code edit be AUTHORIZED?" — and must fail closed
# when it cannot resolve the active task; this hook only asks "are there open
# gates to finish?", and an absent task has none. The two should NOT be forced to
# agree. (See docs/guarantee-ledger.json PB-COMMAND-FAILURE-POLICY.)
if [ -z "$TASK_FILE" ]; then
    PB_HJ_DECISION=allow; PB_HJ_DETAIL="released: task file not found"
    exit 0
fi

# Blocked state (#08): a task paused awaiting the owner's decision is NOT waiting
# on the agent — let the turn end without a fabricated checkbox. Keyed on the
# status marker (the line after `## Status`), NOT on gate text, so it can't
# inherit the freehand bypass's first-unchecked-gate fragility.
# The status, the live unchecked-gate count, the first live unchecked gate and
# the Freehand release decision (`release`/`hold`, core._freehand_release_allowed:
# first live gate is `Freehand…` but not `Freehand log`, at indent < 4, and the
# file has no unclosed fence — round-1 panel: the hook's own prefix test on the
# gate text released on a blank-first-gate, an unclosed-fenced or an indented
# decoy) are read by ONE spawn of scripts/task-status.py --fields, which calls the SAME
# readers the CLI uses (core.py::_extract_status — LAST live `## Status` wins,
# fence-aware, fail closed on an unclosed fence; core.py::_live_gate_state —
# fence-aware line-anchored gates, an unclosed fence hides nothing). Until task
# 043 the status was an awk mirror of a fence-blind rule, so a `## Status`/blocked
# pair quoted inside a code fence released unchecked gates (P-F); until task 055
# the gates were `grep -c` + `grep -m1`, so a fenced `- [ ] Freehand…` example
# quoted before a real open gate became FIRST_GATE and the Freehand arm released
# the stop with work left. One implementation, not two: Python and the enforcing
# hook cannot disagree about the same file (the #09 disease).
# If the reader cannot run (no python3, import failure) the state is UNREADABLE:
# say so and fall back to the fence-blind grep for the COUNT only — it can only
# over-count (a fence hides lines, never adds them; the grep is BOM-tolerant like
# the Python reader, and a grep ERROR counts as >= 1 open gate AND disarms the
# chat-reply rule — task 072), so an open gate still gets its memento (the
# chat-reply rule below applies only to a COUNTED tree); the status is never
# guessed `blocked` and the Freehand rule is NOT applied to a grep-derived first
# gate (it could be the decoy).
PB_STATE_READ=true
PB_GREP_RC=0
STATUS_LINE=""
UNCHECKED=""
FIRST_GATE=""
PB_RELEASE=""
PB_SAMPLE_READ=""
if [ "$PB_PY_FLOOR" = true ]; then
{
    IFS= read -r STATUS_LINE || PB_STATE_READ=false
    IFS= read -r UNCHECKED   || PB_STATE_READ=false
    IFS= read -r FIRST_GATE  || PB_STATE_READ=false
    IFS= read -r PB_RELEASE  || PB_STATE_READ=false
    IFS= read -r PB_SAMPLE_READ || true     # task 234: the suspend sample, for the journal line only
} < <(python3 -E -s "$HOOK_DIR/task-status.py" --fields "$TASK_FILE" 2>/dev/null) || PB_STATE_READ=false
read -r PB_HJ_SUSP PB_HJ_STS PB_HJ_BOOT _ <<< "${PB_SAMPLE_READ:-}" || true
else
    PB_STATE_READ=false    # below the floor (task 193): the reader is not run; the python-free count below
fi
# Read tolerance: a CR-terminated field (`blocked\r`) would miss the exact
# matches below; drop one trailing CR per field (same idiom as scripts/init's
# manifest reader).
STATUS_LINE=${STATUS_LINE%$'\r'}
UNCHECKED=${UNCHECKED%$'\r'}
FIRST_GATE=${FIRST_GATE%$'\r'}
PB_RELEASE=${PB_RELEASE%$'\r'}
case "$UNCHECKED" in
    ''|*[!0-9]*) PB_STATE_READ=false ;;   # a partial/garbled frame is unreadable, not "0 gates"
esac
case "$PB_RELEASE" in
    release|hold) ;;
    *) PB_STATE_READ=false ;;              # an unknown 4th field is unreadable, never "release"
esac
if [ "$PB_STATE_READ" != true ]; then
    echo "[stop-hook] WARNING: could not read the task state via python3 ($HOOK_DIR/task-status.py --fields) — treating the status as unreadable, counting gates fence-blind (over-counts, never under-counts) and disabling the Freehand release" >&2
    STATUS_LINE=""
    PB_RELEASE="hold"
    # Count unchecked gates fence-blind — a LINE count that may only OVER-count
    # the Python reader (task 072, 070 release panel):
    #  * BOM-tolerant like core._live_gate_scan (`line.lstrip("\ufeff")`): a gate
    #    pasted from a BOM-writing editor is live for the CLI and the Python arm,
    #    so it must be live here too. The U+FEFF bytes are built with printf
    #    (bash 3.2 / BSD grep have no `\x` escapes) and matched byte-wise under
    #    LC_ALL=C so the pattern means the same thing in every locale.
    #  * grep's exit code is read: 0/1 = a count was taken (1 = zero matches);
    #    anything else (unreadable file, unsupported regex, broken binary) is NOT
    #    "0 gates" — the count could not be taken, so the arm assumes >= 1 open
    #    gate, loudly. `|| UNCHECKED=0` used to drop the stop's answer here.
    #  * `set -e` is on: the capture runs inside `if` so a non-zero grep can
    #    neither abort the hook open (I1) nor be mistaken for a count.
    PB_BOM=$(printf '\357\273\277')
    PB_GATE_ERE="^(${PB_BOM})*[[:space:]]*- \[ \]"
    if UNCHECKED=$(LC_ALL=C grep -cE "$PB_GATE_ERE" "$TASK_FILE" 2>/dev/null); then :; else PB_GREP_RC=$?; fi
    # Digits-only: a shell glob `[0-9]*` is "one digit then ANYTHING", so the
    # shape must be tested with the `*[!0-9]*` idiom (round-3 codex ×2).
    PB_COUNT_OK=false
    case "$PB_GREP_RC" in 0|1)
        case "$UNCHECKED" in ''|*[!0-9]*) ;; *) PB_COUNT_OK=true ;; esac
    ;; esac
    case "$PB_COUNT_OK" in
        true) ;;
        *)
            echo "[stop-hook] WARNING: grep could not count the gates in $TASK_FILE (exit $PB_GREP_RC) — assuming at least one open gate (fail closed)" >&2
            UNCHECKED=1
            [ "$PB_GREP_RC" -le 1 ] && PB_GREP_RC=2   # garbled output = a count NOT taken
            FIRST_GATE="(unreadable — python3 and grep both unavailable; open task.md)"
            ;;
    esac
    if [ "$PB_GREP_RC" -le 1 ]; then
        FIRST_GATE=$(LC_ALL=C grep -m1 -E "$PB_GATE_ERE" "$TASK_FILE" 2>/dev/null | LC_ALL=C sed -E "s/^(${PB_BOM})*[[:space:]]*- \[ \] *//") \
            || FIRST_GATE="(unreadable — the first-gate read failed after the count; open task.md)"
    fi
fi
case "$STATUS_LINE" in
    blocked) PB_HJ_DECISION=allow; PB_HJ_DETAIL="released: task ${TASK} blocked"; exit 0 ;;   # core._is_blocked: the EXACT token (the writer only ever writes the bare word)
esac

if [ "$UNCHECKED" -eq 0 ]; then
    PB_HJ_DECISION=allow; PB_HJ_DETAIL="released: all gates of task ${TASK} checked"
    exit 0
fi

# The chat-reply rule: a turn with low activity (writes 0 and tools < 5, counted from the user's last prompt) is a
# conversational reply, and gets no memento. Not when the gate COUNT itself failed (task 072 round 2, codex), nor
# when the counts are not sure (task 182): a tool call's hook that was not given the counters lock did not count its
# call and left the mark `counts_unsure` — a `writes` that is behind would read as a chat reply. Any `counts_unsure`
# entry counts — a dangling link too, which `-e` reads as absent — and so does a linked session directory:
# `_counters_mark` refuses to write through a link (task 193), so there an uncounted call could leave no mark. A
# missing counters file reads as a working turn. (A notification does not reset the counts — the owner's Q1,
# 2026-09-24 — so a turn started by one gets the memento when the turn before it wrote; until task 340 its marks
# released such a turn from the block.)
COUNTER_FILE="$PB_ACTIVITY_DIR/counters"
PB_COUNTS_SURE=true
if [ -e "$PB_ACTIVITY_DIR/counts_unsure" ] || [ -L "$PB_ACTIVITY_DIR/counts_unsure" ] \
   || ! _pb_session_dir_ok "$PB_ACTIVITY_DIR"; then    # or a linked `sessions` (task 194, impl panel r1)
    PB_COUNTS_SURE=false
fi
if [ -f "$COUNTER_FILE" ] && [ "${PB_GREP_RC:-0}" -le 1 ] && [ "$PB_COUNTS_SURE" = true ]; then
    # read_counter_int (not read_counter): coerce the .agent/-resident counter to a plain non-negative integer before
    # `-eq`/`-lt`, which would otherwise evaluate a crafted counter as an arithmetic expression under `set -e`.
    WRITES=$(read_counter_int "$COUNTER_FILE" writes)
    TOOLS=$(read_counter_int "$COUNTER_FILE" tools)
    if [ "$WRITES" -eq 0 ] && [ "$TOOLS" -lt 5 ]; then
        PB_HJ_DECISION=allow; PB_HJ_DETAIL="released: a chat reply (writes 0, tools ${TOOLS})"
        exit 0
    fi
fi

# The Freehand gate: the user drives, no memento (decided in Python, `core._freehand_release_allowed`; never on a
# grep-derived first gate).
if [ "$PB_STATE_READ" = true ] && [ "$PB_RELEASE" = release ]; then
    PB_HJ_DECISION=allow; PB_HJ_DETAIL="released: freehand gate"
    exit 0
fi

PB_COUNTED=""
[ "$PB_STATE_READ" = true ] || PB_COUNTED=" (counted without python3)"
pb_memento "playbook: task ${TASK} has ${UNCHECKED} open gate(s)${PB_COUNTED} — next: ${FIRST_GATE}" "${UNCHECKED} open gate(s) in task ${TASK}"
